---
// The footer, on black: Home's last line ("Let’s talk!") and the ways to reach
// Mig under a white heavy rule. The arrow comes in as a row is pointed at.
import { CONTACT } from '../consts';
import { rise } from '../utils/text';

const rows = [
  { href: `mailto:${CONTACT.email}`, label: CONTACT.email },
  { href: CONTACT.phoneHref, label: CONTACT.phoneDisplay, blank: true },
  { href: CONTACT.linkedin, label: 'LinkedIn', blank: true },
  { href: CONTACT.cv, label: 'Download my CV', blank: true },
];
---

<footer id="contact" class="ft">
  <div class="ft-top">
    <h2 class="t-state ft-line" data-rise set:html={rise('Hiring, briefing, or | looking to connect? | Let’s talk!')} />
    <nav class="ft-links" aria-label="Contact" data-rv style="--d: 1;">
      {
        rows.map(({ href, label, blank }) => (
          <a class="ft-link t-copy" href={href} target={blank ? '_blank' : undefined} rel={blank ? 'noopener' : undefined}>
            <span class="ft-label">{label}</span>
            <svg class="ft-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
              <path d="M7 17 17 7" />
              <path d="M8.5 7H17v8.5" />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
  <div class="ft-base t-small">
    <span class="ft-c">© 2026 Miguel Escobar</span>
    <span class="ft-s">Ownself Vibe Code</span>
  </div>
</footer>

<style is:global>
  .ft {
    position: relative;
    z-index: 2;
    padding: calc(48px - var(--trim-s)) var(--mi) 38.056px;
    background: var(--ink);
    color: var(--white);
  }
  .ft-line {
    max-width: 10em;
  }
  .ft-links {
    margin-top: 40px;
    border-top: var(--heavy) solid var(--white);
  }
  .ft-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: calc(19px - var(--trim)) 0;
    text-decoration: none;
  }
  .ft-link + .ft-link {
    border-top: var(--hair) solid var(--grey);
  }
  .ft-arrow {
    flex-shrink: 0;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.3s ease,
      transform 0.5s var(--ease);
  }
  .ft-label {
    transition: transform 0.5s var(--ease);
  }
  .ft-link:hover .ft-arrow,
  .ft-link:focus-visible .ft-arrow {
    opacity: 1;
    transform: none;
  }
  .ft-link:hover .ft-label {
    transform: translateX(4px);
  }
  .ft-base {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 56px;
    padding-top: calc(14px - var(--trim));
    border-top: var(--hair) solid var(--grey);
  }
  .ft-s {
    margin-left: auto;
  }
  /* The line in columns 6–11, the rows in 14–20. */
  @media (min-width: 900px) {
    .ft {
      padding: calc(var(--pitch) - var(--trim-s)) var(--m) calc(var(--pitch) - 8px * (1.2 - 0.714) / 2);
    }
    .ft-top {
      display: grid;
      grid-template-columns: repeat(20, minmax(0, 1fr));
      column-gap: var(--g);
      align-items: start;
    }
    .ft-line {
      grid-column: 6 / span 6;
      max-width: none;
    }
    .ft-links {
      grid-column: 14 / span 7;
      margin-top: var(--trim-s);
    }
    .ft-base {
      display: grid;
      grid-template-columns: repeat(20, minmax(0, 1fr));
      column-gap: var(--g);
      margin-top: var(--pitch);
    }
    .ft-c {
      grid-column: 1 / span 10;
    }
    .ft-s {
      grid-column: 11 / span 10;
      justify-self: end;
    }
  }
</style>
