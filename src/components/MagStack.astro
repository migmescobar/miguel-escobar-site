---
// The throw (Home): three magazines are thrown onto the table once, as they come
// into view, and slide to rest in a fanned pile across the seam of Home's two
// panels — Esquire Philippines (August 2017), Smile (February 2020), and Esquire
// Philippines (December 2016–January 2017) on top, turned left at the front.
// Lit like a magazine's own still lifes: a hard key light from the upper left,
// so each throws a dark, clear-edged shadow down and to the right, with a thin
// contact line where it touches. Sizes are in em: the stack's font-size is 1% of
// its width (--magw, set by home.css). With reduced motion they simply lie there.
import { Image } from 'astro:assets';
import esq2017 from '../assets/images/mag-esquire-2017-08.jpg';
import smile from '../assets/images/mag-smile-2020-02.jpg';
import esq2016 from '../assets/images/mag-esquire-2016-12.jpg';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

// Where each comes to rest (--x, --y, --r), the colour under its cover while it
// loads (--paper), its shadow's and contact line's fall (em), and where it
// leaves the hand, relative to its rest (data-dx, data-dy: %, data-spin: deg).
const mags = [
  {
    image: esq2017,
    style: '--x: 45.85%; --y: -33.15%; --r: 22deg; --paper: #2c2b2e; --sx: 6.25em; --sy: 3.73em; --cx: 0.76em; --cy: 0.55em;',
    dx: -22,
    dy: 210,
    spin: -34,
  },
  {
    image: smile,
    style: '--x: 7.85%; --y: -25.65%; --r: 1.5deg; --paper: #5f8389; --sx: 4.55em; --sy: 5.68em; --cx: 0.52em; --cy: 0.79em;',
    dx: 20,
    dy: 225,
    spin: 26,
  },
  {
    image: esq2016,
    style: '--x: 2.85%; --y: 5.35%; --r: -18deg; --paper: #503a39; --sx: 2.39em; --sy: 6.88em; --cx: 0.23em; --cy: 0.92em;',
    dx: -10,
    dy: 235,
    spin: 24,
  },
];
---

<div class:list={['mags', cls]} data-mags data-fall="4.4 5.8" data-contact="0.5 0.8" aria-hidden="true">
  {
    mags.map((m) => (
      <div class="mag" style={m.style} data-dx={m.dx} data-dy={m.dy} data-spin={m.spin}>
        <span class="mag-shadow" />
        <span class="mag-contact" />
        <span class="mag-body">
          <Image
            class="mag-img"
            src={m.image}
            alt=""
            widths={[...new Set([240, 380, m.image.width].filter((w) => w <= m.image.width))]}
            sizes="(min-width: 900px) 11vw, 34vw"
            loading="eager"
            decoding="async"
          />
          <span class="mag-spine" />
          <span class="mag-gloss" />
        </span>
      </div>
    ))
  }
</div>

<style is:global>
  .mags {
    --shade: #140f07;
    position: absolute;
    z-index: 3;
    aspect-ratio: 0.75;
    pointer-events: none;
    font-size: calc(var(--magw, 150px) / 100);
  }
  .mag {
    position: absolute;
    inset: 0;
    transform: translate(var(--x), var(--y)) rotate(var(--r));
    will-change: transform;
  }
  .js .mags:not(.is-thrown) .mag {
    opacity: 0;
  }
  .mag-shadow {
    position: absolute;
    inset: 0;
    transform: translate(var(--sx, 4.4em), var(--sy, 5.8em));
  }
  .mag-shadow::before,
  .mag-shadow::after,
  .mag-contact {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--shade);
  }
  .mag-shadow::before {
    opacity: 0.55;
    filter: blur(0.8em);
  }
  .mag-shadow::after {
    inset: -1em;
    opacity: 0.18;
    filter: blur(6em);
  }
  .mag-contact {
    opacity: 0.6;
    transform: translate(var(--cx, 0.5em), var(--cy, 0.8em));
    filter: blur(0.45em);
  }
  /* The coated cover: a sheen from the top, its edges catching the light. */
  .mag-body {
    position: absolute;
    inset: 0;
    overflow: clip;
    background:
      linear-gradient(180deg, #ffffff73, #fff0 45%, #00000009),
      var(--paper);
    box-shadow:
      0.4px 0.7px #f1eee4,
      0.8px 1.3px #d8d2c2;
  }
  .mag-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mag-spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 5.5%;
    background: linear-gradient(90deg, #0000001f, #ffffff42 30%, #0000000a 58%, #0000);
  }
  /* The gloss stays lit from the upper left whichever way the cover is turned. */
  .mag-gloss {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(calc(135deg - var(--r, 0deg)), #fffcf475, #fffcf429 18%, #fffcf400 40%, #140e0400 58%, #140e0433),
      #fffbf205;
    box-shadow:
      inset 1px 1px #ffffff80,
      inset 0 0 0 0.5px #00000029;
  }
</style>

<script>
  // Positions come from a small model: the magazine leaves the hand above the
  // table and falls to it a third of the way through (a parabola: larger, its
  // shadow longer, softer and fainter while it's up, with no contact shadow
  // until it lands); on the table it slides on with constant friction, so it
  // slows to rest, its spin slowing with it. Sampled into keyframes and played
  // once, when the stack first comes into view.
  const stacks = document.querySelectorAll<HTMLElement>('[data-mags]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TA = 0.32; // share of the throw spent in the air
  const N = 40; // keyframes

  const throwOne = (mag: HTMLElement, i: number) => {
    const body = mag.querySelector<HTMLElement>('.mag-body');
    const shadow = mag.querySelector<HTMLElement>('.mag-shadow');
    const contact = mag.querySelector<HTMLElement>('.mag-contact');
    const cs = getComputedStyle(mag);
    const x = parseFloat(cs.getPropertyValue('--x'));
    const y = parseFloat(cs.getPropertyValue('--y'));
    const r = parseFloat(cs.getPropertyValue('--r'));
    const x0 = x + parseFloat(mag.dataset.dx || '0');
    const y0 = y + parseFloat(mag.dataset.dy || '150');
    const r0 = r + parseFloat(mag.dataset.spin || '0');
    // The shadows' fall on screen (em), held steady as the cover spins; up in
    // the air the cast shadow reaches further along the same line.
    const stack = mag.parentElement as HTMLElement;
    const fall = (stack.dataset.fall || '4.4 5.8').split(' ').map(parseFloat);
    const con = (stack.dataset.contact || '0.5 0.8').split(' ').map(parseFloat);
    const turn = (dx: number, dy: number, a: number) =>
      `translate(${(dx * Math.cos(a) + dy * Math.sin(a)).toFixed(2)}em, ${(-dx * Math.sin(a) + dy * Math.cos(a)).toFixed(2)}em)`;

    const v0 = 1 / (TA + (1 - TA) / 2);
    const mk: Keyframe[] = [];
    const sk: Keyframe[] = [];
    const ck: Keyframe[] = [];
    for (let k = 0; k <= N; k++) {
      const t = k / N;
      const s = t <= TA ? v0 * t : v0 * TA + v0 * (t - TA) - (v0 * (t - TA) * (t - TA)) / (2 * (1 - TA));
      const h = t < TA ? 1 - (t / TA) * (t / TA) : 0;
      const px = x0 + (x - x0) * s;
      const py = y0 + (y - y0) * s;
      const pr = r0 + (r - r0) * s;
      mk.push({
        offset: t,
        opacity: Math.min(1, t / 0.06),
        transform: `translate(${px.toFixed(2)}%, ${py.toFixed(2)}%) rotate(${pr.toFixed(2)}deg) scale(${(1 + 0.1 * h).toFixed(4)})`,
      });
      const a = (pr * Math.PI) / 180;
      sk.push({
        offset: t,
        opacity: (1 - 0.4 * h).toFixed(3),
        transform: turn(fall[0] * (1 + 3.4 * h), fall[1] * (1 + 3.4 * h), a),
        filter: `blur(${(5 * h).toFixed(2)}em)`,
      });
      ck.push({ offset: t, opacity: (0.6 * Math.max(0, 1 - 6 * h)).toFixed(3), transform: turn(con[0], con[1], a) });
    }
    const timing: KeyframeAnimationOptions = { duration: 1380 - i * 60, delay: i * 180, easing: 'linear', fill: 'both' };
    mag.animate(mk, timing);
    shadow?.animate(sk, timing);
    contact?.animate(ck, timing);
    // The landing: the cover flexes flat for an instant.
    body?.animate([{ transform: 'none' }, { transform: 'scale(0.992, 1.004)' }, { transform: 'none' }], {
      duration: 160,
      delay: (timing.delay as number) + (timing.duration as number) * TA - 30,
      easing: 'ease-out',
    });
  };

  const go = (stack: HTMLElement) => {
    if (stack.classList.contains('is-thrown')) return;
    const ms = stack.querySelectorAll<HTMLElement>('.mag');
    if (!reduce && ms.length && typeof ms[0].animate === 'function') ms.forEach(throwOne);
    stack.classList.add('is-thrown');
  };

  if (reduce || !('IntersectionObserver' in window)) {
    stacks.forEach(go);
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting || en.boundingClientRect.top < 0) {
            io.unobserve(en.target);
            go(en.target as HTMLElement);
          }
        }
      },
      { rootMargin: '0px 0px -28% 0px' }
    );
    stacks.forEach((s) => io.observe(s));
  }
</script>
