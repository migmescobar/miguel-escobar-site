---
import ContactForm from './ContactForm.astro';
import { CONTACT } from '../consts';
---

<footer id="contact" class="site-footer" aria-labelledby="contact-heading">
  <div class="contact wrap" data-reveal>
    <div class="contact-left">
      <h2 id="contact-heading" class="display">Let’s talk</h2>
      <p class="lede">Hiring, briefing, or looking to connect? Hit me up and help me escape the permanent underclass.</p>
      <div class="links">
        <a href={CONTACT.cv} target="_blank" rel="noopener" class="cv">Download my CV</a>
        <a href={CONTACT.phoneHref} class="tel" set:html={CONTACT.phoneDisplay.replace(/ /g, '&nbsp;')}
        ></a>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>

    <ContactForm />
  </div>

  <div class="copyright wrap">
    <span>© 2026 MIGUEL ESCOBAR</span>
    <span>OWNSELF VIBE CODE</span>
  </div>
</footer>

<style>
  /* Contact + footer is a white-on-blue block (matches the header home dot). */
  .site-footer {
    background: var(--brand-blue);
    color: var(--paper);
    padding: clamp(56px, 8vw, 104px) var(--pad) clamp(44px, 5vw, 68px);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    /* Each column takes its natural height, so the shorter links column doesn't
       stretch and leave a ragged base at mid-widths. */
    align-items: flex-start;
    gap: 40px 48px;
  }
  .contact-left {
    flex: 1 1 320px;
    min-width: 260px;
  }
  h2 {
    margin: 0 0 16px;
    font-size: clamp(42px, 5.4vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.012em;
    color: #fff;
  }
  .lede {
    margin: 0 0 28px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--white-85);
    max-width: 400px;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 16px;
    align-items: flex-start;
  }
  .links a {
    color: var(--paper);
    text-decoration-color: var(--white-55);
  }
  .links a:hover {
    text-decoration-color: #fff;
  }
  .links .cv {
    color: #fff;
  }
  .links .tel {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .links .tel:hover {
    border-bottom-color: #fff;
  }

  .copyright {
    margin-top: clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--white-25);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--white-70);
  }
</style>
