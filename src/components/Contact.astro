---
// Site footer + the only contact block on the site (there is no Contact page,
// and no form — this design carries contact as four plain links).
import { CONTACT } from '../consts';
---

<footer id="contact" class="site-footer" aria-labelledby="contact-heading">
  <div class="upper wrap">
    <div class="lede-col">
      <h2 id="contact-heading">Let’s talk</h2>
      <p>Hiring, briefing, or looking to connect? Hit me up and help me escape the permanent underclass.</p>
    </div>

    <div class="links">
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a href={CONTACT.phoneHref} set:html={CONTACT.phoneDisplay.replace(/ /g, '&nbsp;')}></a>
      <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={CONTACT.cv} target="_blank" rel="noopener">Download my CV</a>
    </div>
  </div>

  <div class="lower wrap">
    <span>© 2026 MIGUEL ESCOBAR</span>
    <span>OWNSELF VIBE CODE</span>
  </div>
</footer>

<style>
  /* The one inverted block on the site. No border-top: the colour change is
     the boundary, and a light hairline would read as a stray line on paper.
     Everything inside inherits currentColor, so the rules and muted text
     invert with it. */
  .site-footer {
    background: var(--footer-bg);
    color: var(--paper);
    margin-top: clamp(56px, 8vw, 112px);
    padding: clamp(32px, 4.5vw, 60px) var(--pad) 0;
  }
  /* The global hover underline is --accent (blue), which sits at 1.5:1 on this
     ground — effectively invisible. Inside the footer the underline goes to
     full currentColor instead: same "underline shifts on hover" behaviour,
     tonal rather than chromatic, and no new brand colour. */
  .site-footer a:hover {
    text-decoration-color: currentColor;
  }

  .upper {
    padding-bottom: clamp(44px, 6.5vw, 88px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 64px);
    justify-content: space-between;
    align-items: flex-start;
  }
  .lede-col {
    flex: 0 1 auto;
  }
  .lede-col h2 {
    margin: 0;
    font-size: clamp(26px, 2.9vw, 40px);
    line-height: 1.04;
    letter-spacing: -0.008em;
  }
  .lede-col p {
    margin: 14px 0 0;
    max-width: 40ch;
    font-size: 16px;
    line-height: 1.55;
    opacity: 0.8;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.35;
    align-items: flex-start;
  }

  .lower {
    padding: 0 0 clamp(16px, 2.2vw, 26px);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.12em;
    /* .5 measured 3.74:1 on the new dark ground — below AA for text this
       small. .65 keeps it recessive at a comfortable 5.2:1. */
    opacity: 0.65;
  }
</style>
