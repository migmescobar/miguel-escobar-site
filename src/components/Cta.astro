---
// The button: 12px capitals and a hairline ring with an arrow (global.css). Its
// ring fills with the accent of the part of the page it sits in.
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="cta" href={href}
  ><span class="cta-label">{label}</span><span class="cta-ring"
    ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M0.5 6.5h11"></path><path d="M7.5 2l4 4.5-4 4.5"></path></svg
    ></span
  ></a
>
