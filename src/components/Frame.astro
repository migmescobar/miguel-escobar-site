---
// A picture cropped to a frame: the image fills it (object-fit: cover) on white
// while it loads. Inside a [data-rv] part, it rises into the frame from the
// bottom edge as the part arrives (global.css). Optimised at build time into AVIF/WebP at several
// widths, with a JPEG fallback.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio of the frame, e.g. "4 / 3". */
  ratio: string;
  /** CSS object-position, e.g. "50% 35%". */
  position?: string;
  sizes: string;
  widths?: number[];
  quality?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  alt,
  ratio,
  position = '50% 50%',
  sizes,
  widths = [320, 480, 640, 960],
  quality = 82,
  loading = 'lazy',
  class: cls,
} = Astro.props;

// Never ask for a width larger than the source; always offer the native width.
const finalWidths = [...new Set([...widths.filter((w) => w < image.width), image.width])].sort((a, b) => a - b);
---

<div class:list={['frame', cls]} style={`aspect-ratio: ${ratio};`}>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    quality={quality}
    widths={finalWidths}
    sizes={sizes}
    loading={loading}
    decoding="async"
    draggable="false"
    style={`object-position: ${position};`}
  />
</div>
