---
// Per-page <head>: title, meta description, Open Graph/Twitter, canonical,
// JSON-LD, self-hosted fonts, favicon, and (in production) analytics.
import { SITE_URL, SITE_TITLE, CONTACT, GOATCOUNTER_CODE, GOATCOUNTER_READY } from '../consts';

// Self-hosted Geist (woff2, font-display: swap) — latin subset only, needed weights.
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-500.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/global.css';

// Preload the display serif so the browser starts fetching it while the CSS is
// still downloading. Without this it's only discovered after the CSS parses, so
// the big serif headings paint in fallback Georgia first and visibly swap.
// Imported (not hard-coded) so the href tracks Astro's content hash.
import editorialSerif from '../assets/fonts/editorial-new-400.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** Emit Person JSON-LD (home page only). */
  personSchema?: boolean;
  /** Clean post title (no site suffix) for the BlogPosting headline + OG alt. */
  articleHeadline?: string;
}

const {
  title,
  description,
  image = '/og-image.png',
  type = 'website',
  publishedTime,
  personSchema = false,
  articleHeadline,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
const ogImage = new URL(image, SITE_URL);

const imageAlt =
  type === 'article' && articleHeadline
    ? `${articleHeadline} — ${SITE_TITLE}`
    : `${SITE_TITLE} — Strategic Communications, Content Governance, Editorial Operations, APAC Markets`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_TITLE,
  jobTitle: 'Communications Professional',
  url: SITE_URL,
  sameAs: [CONTACT.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Singapore' },
};

// BlogPosting structured data for Thoughts posts.
const blogPosting =
  type === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: articleHeadline ?? title,
        description,
        datePublished: publishedTime,
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        image: ogImage.href,
        author: { '@type': 'Person', name: SITE_TITLE, url: SITE_URL },
        publisher: { '@type': 'Person', name: SITE_TITLE },
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- crossorigin is required even same-origin: fonts fetch in anonymous CORS
     mode, and without it the browser downloads the file a second time. -->
<link rel="preload" href={editorialSerif} as="font" type="font/woff2" crossorigin />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#EAE7E1" />

<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{personSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
)}
{blogPosting && (
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
)}

<!-- Reveal-on-scroll: opt in before paint (no flash), with a guaranteed failsafe. -->
<script is:inline>
  (function () {
    var d = document.documentElement;
    if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
    d.classList.add('reveal-ready');
    setTimeout(function () {
      var els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
      for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
    }, 1500);
  })();
</script>

{GOATCOUNTER_READY && import.meta.env.PROD && (
  <script
    is:inline
    data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
    async
    src="//gc.zgo.at/count.js"></script>
)}
