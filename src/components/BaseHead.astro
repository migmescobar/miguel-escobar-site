---
// Per-page <head>: title, meta description, Open Graph/Twitter, canonical,
// JSON-LD, the self-hosted font, favicon, and (in production) analytics.
import { SITE_URL, SITE_TITLE, CONTACT, GOATCOUNTER_CODE, GOATCOUNTER_READY } from '../consts';

import '../styles/global.css';

// Preload the one face used above the fold so the browser fetches it while the
// CSS is still downloading (otherwise it's only discovered after the CSS parses
// and text paints in the fallback first). Imported, not hard-coded, so the href
// tracks Astro's content hash. The italic is left to normal discovery.
import textSans from '../assets/fonts/neue-montreal-400.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** Emit Person JSON-LD (home page only). */
  personSchema?: boolean;
  /** Clean post title (no site suffix) for the BlogPosting headline + OG alt. */
  articleHeadline?: string;
  /** Keep this page out of search results (the 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-image.png',
  type = 'website',
  publishedTime,
  personSchema = false,
  articleHeadline,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
const ogImage = new URL(image, SITE_URL);

const imageAlt =
  type === 'article' && articleHeadline
    ? `${articleHeadline} — ${SITE_TITLE}`
    : `${SITE_TITLE} — Strategic Communications, Content Governance, Editorial Operations, APAC Markets`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_TITLE,
  jobTitle: 'Communications Professional',
  url: SITE_URL,
  sameAs: [CONTACT.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Singapore' },
};

// BlogPosting structured data for Thoughts posts.
const blogPosting =
  type === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: articleHeadline ?? title,
        description,
        datePublished: publishedTime,
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        image: ogImage.href,
        author: { '@type': 'Person', name: SITE_TITLE, url: SITE_URL },
        publisher: { '@type': 'Person', name: SITE_TITLE },
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- crossorigin is required even same-origin: fonts fetch in anonymous CORS
     mode, and without it the browser downloads the file a second time. -->
<link rel="preload" href={textSans} as="font" type="font/woff2" crossorigin />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#EAE7E1" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{personSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
)}
{blogPosting && (
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
)}

<!-- Scripted reveals on Home: hide their parts only when script runs, and show
     everything anyway if the page's own script hasn't started within 4s. -->
<script is:inline>
  (function () {
    var d = document.documentElement;
    d.classList.add('js');
    setTimeout(function () {
      if (!d.classList.contains('js-ready')) d.classList.remove('js');
    }, 4000);
  })();
</script>

{GOATCOUNTER_READY && import.meta.env.PROD && (
  <script
    is:inline
    data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
    async
    src="//gc.zgo.at/count.js"></script>
)}
