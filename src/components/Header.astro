---
import { NAV_LINKS } from '../consts';

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  const base = href.replace(/\/$/, '');
  const here = path.replace(/\/$/, '');
  if (base === '') return here === '';
  return here === base || here.startsWith(base + '/');
}

// The two "More …" pages live under Work, so Work stays lit while you're on them.
const WORK_SECTION = ['/work/', '/editorial-work/', '/advertising-work/'];
const current = (href: string) =>
  href === '/work/' ? WORK_SECTION.some(isActive) : isActive(href);
---

<header>
  <div class="bar wrap">
    <a class="wordmark" href="/">MIGUEL ESCOBAR</a>

    <nav class="nav-desktop" aria-label="Primary">
      {
        NAV_LINKS.map(({ href, label }) => (
          <a
            href={href}
            class:list={['nav-link', { active: current(href) }]}
            aria-current={current(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <button
      class="nav-burger"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="nav-mobile wrap" aria-label="Primary mobile" hidden>
    {
      NAV_LINKS.map(({ href, label }) => (
        <a
          href={href}
          class:list={['m-link', { active: current(href) }]}
          aria-current={current(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--paper);
    padding: clamp(18px, 2.2vw, 26px) var(--pad) clamp(14px, 1.8vw, 20px);
  }
  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .wordmark {
    font-size: clamp(16px, 1.5vw, 20px);
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 1;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
  }
  .wordmark:hover {
    border-bottom-color: var(--ink);
  }

  .nav-desktop {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
  }
  .nav-link {
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
  }
  .nav-link:hover,
  .nav-link.active {
    border-bottom-color: var(--ink);
  }

  /* The hand-off set this to the wordmark's exact cap height (11.5px), but a
     hard-edged three-bar stack reads taller than letterforms at the same
     height, so it's pulled in to 17 × 10px — optically shorter than the caps,
     which is what actually looks level. The 1.5px stroke and the 3.4px bottom
     margin are unchanged: with align-self:center the margin box is what gets
     centred, so the margin (not the height) is what sets the stack's centre —
     shrinking the box keeps it on the same cap-band centre. Don't switch this
     to align-self:baseline: a button whose children are empty spans has no text
     baseline, and the browser synthesises one that pins only the top bar. */
  .nav-burger {
    position: relative;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    align-self: center;
    width: 17px;
    height: 10px;
    margin: 0 0 3.4px;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: currentColor;
  }
  /* 44 × 44 tap target without affecting layout. */
  .nav-burger::before {
    content: '';
    position: absolute;
    inset: -16px -13px;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 10px 0 0;
  }
  .nav-mobile.open {
    display: flex;
  }
  /* Capped at the wordmark's size so the menu never out-shouts it. The active
     item is marked by colour alone — no weight change. */
  .m-link {
    font-size: 16px;
    font-weight: 400;
    color: color-mix(in srgb, currentColor 75%, transparent);
    text-decoration: none;
    padding: 13px 0;
    border-top: 1px solid var(--hairline);
  }
  .m-link.active {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .nav-desktop {
      display: none;
    }
    .nav-burger {
      display: flex;
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!burger || !menu) return;
    menu.classList.toggle('open', open);
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
  }

  burger?.addEventListener('click', () => {
    setOpen(!menu?.classList.contains('open'));
  });

  // Close when a menu item is tapped, or on Escape.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  // Reset when resizing up to desktop so the menu can't get stuck open.
  window.matchMedia('(min-width: 641px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
