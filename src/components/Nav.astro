---
// The nav: a single line, a hairline under a band of paper, held at the top of
// the screen as the page moves under it (40px down on the phone, a column and
// its gutter on the desktop). No links: Home is the way round the site, and the
// footer carries the ways to reach Mig. On Home it lands 30% of the way down the
// screen, over the name, as the masthead's rule, and rides up with the page
// until it rests.
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

<div class:list={['nv', { 'nv-home': home }]} aria-hidden="true" data-nav>
  <div class="nv-line"></div>
</div>

<style is:global>
  .nv {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
  }
  .nv-line {
    height: var(--navh);
    margin-inline: var(--m);
    border-bottom: var(--hair) solid var(--ink);
  }
  .nv-home {
    margin-top: max(0px, calc(var(--navl) - var(--navh)));
  }
  @media (max-width: 899px) {
    .nv-home .nv-line {
      margin-inline: var(--mi);
    }
  }
</style>
