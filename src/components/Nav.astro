---
// The nav: a single line, a hairline under a band of paper, held at the top of
// the screen as the page moves under it (40px down on the phone, a column and
// its gutter on the desktop). On Home it holds nothing: it lands 30% of the way
// down the screen, over the name, as the masthead's rule, and rides up with the
// page until it rests. On every other page Mig's name stands centred in the
// band, set as the hero sets it (Writer capitals, -0.05em), as the way home.
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

{
  home ? (
    <div class="nv nv-home" aria-hidden="true" data-nav>
      <div class="nv-line" />
    </div>
  ) : (
    <header class="nv" data-nav>
      <div class="nv-line nv-line-name">
        <a class="nv-name" href="/">
          Miguel Escobar
        </a>
      </div>
    </header>
  )
}

<style is:global>
  .nv {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
  }
  .nv-line {
    height: var(--navh);
    margin-inline: var(--m);
    border-bottom: var(--hair) solid var(--ink);
  }
  /* The name: the hero's face, capitals and tracking, at nav size. */
  .nv-line-name {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nv-name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }
  .nv-name:hover {
    opacity: 0.6;
  }
  @media (min-width: 900px) {
    .nv-name {
      font-size: 24px;
    }
  }
  .nv-home {
    margin-top: max(0px, calc(var(--navl) - var(--navh)));
  }
  @media (max-width: 899px) {
    .nv-home .nv-line {
      margin-inline: var(--mi);
    }
  }
</style>
