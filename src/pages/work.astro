---

<BaseLayout
  title="Work — Miguel Escobar"
  description="Selected work by Miguel Escobar — launch content for Singapore’s Online Safety Commission and IMDA, campaigns for Trust Bank and the NBA, and features for Esquire Philippines."
  current="work"
>
  <div class="me-pagehead">
    <h1 class="t-xl me-pagetitle">Work</h1>
    <p class="t-lead me-pagesub">Twelve years of stories and campaigns, from Manila to Singapore</p>
  </div>

  {
    sections.map((s, i) => (
      <section
        id={s.id}
        class:list={['me-wsec', { 'me-wsec-first': i === 0, 'me-wsec-last': i === sections.length - 1 }]}
        aria-labelledby={`${s.id}-h`}
      >
        <div class="me-wrule" aria-hidden="true" />
        <h2 id={`${s.id}-h`} class="me-wsec-title">
          {s.title}
        </h2>
        <div class="me-wgrid">
          {s.cards.map((c) => {
            // The whole card links, unless its copy carries its own links.
            const Tag = c.href ? 'a' : 'div';
            return (
              <Tag
                class="me-wcard"
                href={c.href}
                target={c.href ? '_blank' : undefined}
                rel={c.href ? 'noopener' : undefined}
              >
                <Frame
                  image={c.image}
                  alt={c.alt}
                  ratio="4 / 3"
                  position={c.position}
                  sizes="(max-width: 599px) 92vw, (max-width: 1199px) 46vw, 23vw"
                  widths={[360, 540, 720, 1080]}
                />
                <p class="t-label me-wlabel">{c.label}</p>
                <div class="me-wbody">
                  <h3 class="me-wtitle" set:html={keepCompounds(c.title)} />
                  <p class="me-wdesc" set:html={keepCompounds(c.desc)} />
                </div>
              </Tag>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .me-wsec {
    padding: 112px var(--pad) 0;
  }
  .me-wsec-first {
    padding-top: 48px;
  }
  .me-wsec-last {
    padding-bottom: 112px;
  }
  .me-wrule {
    border-top: 1px solid var(--fg);
  }
  .me-wsec-title {
    margin: 12px 0 0;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.012em;
  }
  /* Cards: image over label, title and words; four to a row on the desktop,
     two on tablets and small laptops, one on phones. */
  .me-wgrid {
    margin-top: 28px;
    display: grid;
    gap: 20px;
  }
  .me-wcard {
    display: block;
    padding-bottom: 12px;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--fg);
    background: var(--bg);
  }
  a.me-wcard:hover .me-wtitle {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  .me-wlabel,
  .me-wbody {
    padding: 0 12px;
  }
  .me-wlabel {
    margin-top: 16px;
  }
  .me-wtitle {
    margin: 8px 0 0;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--fg);
    text-wrap: balance;
  }
  .me-wdesc {
    margin: 7.6px 0 0;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: var(--fg85);
    text-wrap: pretty;
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .me-wgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .me-wsec {
      padding-top: clamp(128px, 13.333vw, 192px);
    }
    .me-wsec-first {
      padding-top: clamp(72px, 7.222vw, 104px);
    }
    .me-wsec-last {
      padding-bottom: clamp(128px, 13.333vw, 192px);
    }
    .me-wsec-title {
      margin-top: 16px;
      font-size: 36px;
      letter-spacing: -0.014em;
    }

    /* Each card spans three rows of the grid (subgrid), so the images, labels
       and titles of the cards in a row line up across it; each card's words
       follow its title. */
    .me-wgrid {
      margin-top: 48px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: 0;
    }
    .me-wcard {
      grid-column: span 3;
      grid-row: span 3;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
      padding-bottom: 0;
    }
    .me-wlabel,
    .me-wbody {
      padding: 0 20px;
    }
    .me-wlabel {
      margin-top: 20px;
    }
    .me-wtitle {
      margin-top: 10px;
      line-height: 1.14;
      letter-spacing: -0.01em;
    }
    .me-wdesc {
      margin-top: 4.52px;
      margin-bottom: 20px;
      font-size: 17px;
      line-height: 1.65;
      letter-spacing: 0.01em;
    }
    /* Rows after the first: the gap goes on the cards, not the grid, since a
       row gap would also open between the rows each card shares. */
    .me-wcard:nth-child(n + 5) {
      margin-top: var(--gap);
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .me-wcard {
      grid-column: span 6;
    }
    .me-wcard:nth-child(n + 3) {
      margin-top: var(--gap);
    }
  }
</style>
