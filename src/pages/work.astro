---
// Work (boards SkWork / SkWorkMobile): "Some work", in two sections, Editorial
// and Advertising, each in the colour of its half of the work, with the
// throughlines between them. Cards: image over kicker, title and words; four to
// a row on the desktop, three on small laptops, two from 600px, one on phones,
// with hairlines between the columns. It replaces the old Editorial Work and
// Advertising Work pages, which redirect to its sections.
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from '../components/Frame.astro';
import { keepCompounds, rise, words } from '../utils/text';
import type { ImageMetadata } from 'astro';

