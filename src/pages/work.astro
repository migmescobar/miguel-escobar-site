---
// Work (boards NewWork*): one page in three sections, after Monocle and The
// Economist — Highlights, More Advertising Work, More Editorial Work. It replaces
// the old Editorial Work and Advertising Work pages, which redirect here.
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from '../components/Frame.astro';
import { keepCompounds } from '../utils/typed';
import type { ImageMetadata } from 'astro';

import ageChecks from '../assets/images/home-age-checks.jpg';
import whitewash from '../assets/images/home-whitewash.jpg';
import pulpit from '../assets/images/home-pulpit.jpg';
import osc from '../assets/images/osc-phone-43.jpg';
import trust from '../assets/images/ads-trust.jpg';
import nba from '../assets/images/ads-nba.jpg';
import gotyme from '../assets/images/ads-gotyme.jpg';
import alcon from '../assets/images/ads-alcon.jpg';
import uson from '../assets/images/ph-politics-uson.jpg';
import culture from '../assets/images/editorial-culture.jpg';
import tatler from '../assets/images/editorial-tatler.jpg';
import smile from '../assets/images/editorial-smile.jpg';
import goodmen from '../assets/images/work-goodmen-43.jpg';
import denim from '../assets/images/work-denim-43.jpg';

/** An inline link in a card's copy. */
const L = (href: string, text: string) =>
  `<a class="ul" href="${href}" target="_blank" rel="noopener">${text}</a>`;

interface Card {
  /** The whole card links here, unless its copy carries its own links. */
  href?: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
  label: string;
  title: string;
  /** HTML: may hold links. */
  desc: string;
}

const highlights: Card[] = [
  {
    href: 'https://www.youtube.com/watch?v=HXkZmhEBnBQ',
    image: ageChecks,
    alt: 'A shopkeeper raising her hand to a boy holding beer beneath an “Under 18” sign, from the Age Assurance Measures campaign',
    position: '50% 35%',
    label: 'Public Service',
    title: 'Age Assurance Measures',
    desc: 'A film, explainers, and ads for the Singapore IMDA, launching age verification in app stores',
  },
  {
    href: 'https://www.esquiremag.ph/politics/opinion/fighting-for-history-on-the-wikipedia-battlefield-a00207-20170817-lfrm2',
    image: whitewash,
    alt: 'Ferdinand Marcos collaged over a redacted Wikipedia “Martial law” article, for “How to Whitewash a Dictator”',
    position: '50% 25%',
    label: 'Investigative Feature',
    title: 'How to Whitewash a\u00a0Dictator on Wikipedia',
    desc: 'A feature on an invisible war for Philippine history, waged by Wikipedia editors through back-and-forth revisions',
  },
  {
    href: 'https://www.esquiremag.ph/long-reads/notes-and-essays/the-rise-of-pastor-culture-and-why-it-must-end-a1513-20170629-lfrm',
    image: pulpit,
    alt: 'Halftone hands reaching toward pixelated images inside retro computer windows, for “A Pulpit for Pastors of Porn.”',
    position: '50% 40%',
    label: 'Investigative Feature',
    title: 'Uncovering Intimate Image Abuse Networks',
    desc: 'An exposé that sparked a nationwide reckoning, with a subculture of men sharing NCII across a network of Facebook groups',
  },
  {
    href: 'https://www.osc.gov.sg/',
    image: osc,
    alt: 'A hand in the dark, lit by the glow of a phone screen.',
    label: 'Public Service',
    title: 'Online Safety Commission Launch',
    desc: 'Web copy, service articles, and explainer videos about online harms, for Singapore’s new commission',
  },
];

const advertising: Card[] = [
  {
    image: trust,
    alt: 'A woman laughing as Singapore dollar notes and gold confetti rain around her, holding up a Trust Bank cashback card.',
    label: 'Integrated Campaign',
    title: 'Trust Bank Cashback Card Launch',
    desc: `An award-winning campaign for the iconic Singapore digital bank: ${L('https://www.youtube.com/watch?v=nhxvOzenBR4', 'film')}, islandwide out-of-home, and ${L('https://advocate.com.sg/portfolio/catch-the-cash/', 'a\u00a0mobile\u00a0cash\u00a0chamber')}`,
  },
  {
    image: nba,
    alt: 'A dramatic NBA promotional collage of San Antonio Spurs and New York Knicks players over city skylines, with a golden basketball.',
    label: 'Branded Newsletter',
    title: 'NBA Asia-Pacific Weeklies',
    desc: 'I wrote the league’s weekly newsletter copy for Australia and New Zealand, Japan, and the Philippines, tuned by market',
  },
  {
    href: 'https://www.youtube.com/watch?v=yBnokrkGRbM',
    image: gotyme,
    alt: 'A grinning presenter in a suit points to a framed portrait of a man held up before a seated audience, from the GoTyme Bank campaign film.',
    label: 'Integrated Campaign',
    title: 'GoTyme Bank Philippines Launch',
    desc: 'Copy and concept for a film and three shorts on the human quality of the digital bank’s service',
  },
  {
    image: alcon,
    alt: 'A woman working at a laptop in a warm-lit, elegant dark-blue office with abstract art behind her, from an Alcon campaign.',
    label: 'Brand Campaign',
    title: 'Alcon Contact Lenses',
    desc: 'Film and visuals for PRECISION1™ and TOTAL1® developed for markets across the globe',
  },
];

const editorial: Card[] = [
  {
    image: uson,
    alt: 'Mocha Uson in a black coat, her mouth covered with a strip of grey tape.',
    position: '50% 8%',
    label: 'Interview Feature',
    title: 'Politics in Esquire',
    desc: `Controversial features on ${L('https://www.esquiremag.ph/long-reads/esqa/salvador-panelo-a1513-a1521-20160919-lfrm3', 'Salvador\u00a0Panelo')}, ${L('https://www.esquiremag.ph/long-reads/what-ive-learned/richard-gordon-what-i-ve-learned-a00207-20170717-lfrm', 'Dick\u00a0Gordon')}, and ${L('https://www.esquiremag.ph/long-reads/profiles/mocha-uson-full-text-a1521-20161202-lfrm4', 'Mocha\u00a0Uson')}, published amid the dawn of online culture wars`,
  },
  {
    href: 'https://www.youtube.com/watch?v=yY4LLYrMHt8',
    image: culture,
    alt: 'A dramatic, low-key editorial close-up portrait of actor Eddie Garcia in a pinstriped suit against a dark background, from a feature in Esquire Philippines.',
    label: 'Interview Feature',
    title: 'Eddie Garcia for Esquire Philippines',
    desc: 'I wrote and produced Esquire’s biggest and most-viewed celebrity feature ever, on an icon of Filipino cinema’s golden age',
  },
  {
    href: 'https://www.tatlerasia.com/power-purpose/ideas-education/art-influence-and-the-purveyors-responsibility-according-to-top-auctioneer-jonathan-crockett',
    image: tatler,
    alt: 'Tatler’s “Asia’s Most Influential” series title, set in white and gold serif lettering on black.',
    label: 'Profiles',
    title: 'Tatler Asia’s Most Influential',
    desc: 'Over 100 microprofiles for the 2021 list, including honourees in Singapore and the Philippines',
  },
  {
    href: 'https://smile.ink-live.com/html5/reader/production/default.aspx?pubname=&edid=029443cb-cf76-46cf-a91b-5360ee2806f0',
    image: smile,
    alt: 'A football match on the town plaza pitch in front of the historic Barotac Nuevo church in Iloilo, for the Smile magazine cover story.',
    label: 'Cover Story',
    title: 'In Basketball Country, An\u00a0Oasis for Football',
    desc: 'Barotac Nuevo, Iloilo, in the February 2020 issue of Smile, Cebu Pacific Air’s in-flight magazine',
  },
  {
    image: goodmen,
    alt: 'A man in a blue shirt holds a stack of books in front of library shelves.',
    label: 'Profile Series',
    title: 'A\u00a0Few Good Men',
    desc: `Purpose-driven entrepreneurs, profiled for Esquire: ${L('https://www.esquiremag.ph/long-reads/profiles/quintin-pastrana-is-building-the-public-libraries-we-should-already-have-a00207-20171020-lfrm2', 'Quintin\u00a0Pastrana')}, ${L('https://www.esquiremag.ph/long-reads/profiles/a-good-man-roy-moore-a00207-20171117-lfrm2', 'Roy\u00a0Moore')}, ${L('https://www.esquiremag.ph/long-reads/profiles/henry-motte-munoz-a-good-man-a00207-20171026-lfrm', 'Henry\u00a0Motte-Muñoz')}, and ${L('https://www.esquiremag.ph/long-reads/profiles/carlo-delantar-turns-travel-and-adventure-into-humanitarian-missions-for-clean-water-a00207-20171006-lfrm', 'Carlo\u00a0Delantar')}`,
  },
  {
    href: 'https://www.esquiremag.ph/style/fashion/local-denimheads-have-produced-the-first-filipino-made-raw-selvedge-jeans-a00207-20171024-lfrm2',
    image: denim,
    alt: 'Folded raw selvedge denim stacked in front of bolts of fabric.',
    label: 'Style Feature',
    title: 'The\u00a0First Filipino Selvedge Denim Label',
    desc: 'The local denimheads behind Léon Denim, the first Filipino-made raw selvedge jeans, for Esquire Philippines',
  },
];

const more = [
  { id: 'advertising', title: 'More Advertising Work', cards: advertising },
  { id: 'editorial', title: 'More Editorial Work', cards: editorial },
];
---

<BaseLayout
  title="Work — Miguel Escobar"
  description="Selected work by Miguel Escobar — launch content for Singapore’s Online Safety Commission and IMDA, campaigns for Trust Bank and the NBA, and features for Esquire Philippines."
  current="work"
>
  <div class="me-pagehead">
    <h1 class="t-xl me-pagetitle">Work</h1>
    <p class="t-lead me-pagesub">Twelve years of stories and campaigns, from Manila to Singapore</p>
  </div>

  <section id="highlights" class="me-wsec me-wsec-first" aria-labelledby="highlights-h">
    <div class="me-wrule" aria-hidden="true"></div>
    <h2 id="highlights-h" class="me-wsec-title">Highlights</h2>
    <div class="me-hgrid">
      {
        highlights.map((c) => (
          <a class="me-wcard me-hcard" href={c.href} target="_blank" rel="noopener">
            <Frame
              image={c.image}
              alt={c.alt}
              ratio="4 / 3"
              position={c.position}
              sizes="(max-width: 599px) 92vw, (max-width: 1199px) 46vw, 23vw"
              widths={[360, 540, 720, 1080]}
            />
            <p class="t-label me-hlabel">{c.label}</p>
            <h3 class="me-wtitle me-htitle" set:html={keepCompounds(c.title)} />
            <p class="me-hdesc" set:html={keepCompounds(c.desc)} />
          </a>
        ))
      }
    </div>
  </section>

  {
    more.map((s, i) => (
      <section
        id={s.id}
        class:list={['me-wsec', { 'me-wsec-last': i === more.length - 1 }]}
        aria-labelledby={`${s.id}-h`}
      >
        <div class="me-wrule" aria-hidden="true" />
        <h2 id={`${s.id}-h`} class="me-wsec-title">
          {s.title}
        </h2>
        <div class="me-mgrid">
          {s.cards.map((c) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <Tag
                class="me-wcard me-mcard"
                href={c.href}
                target={c.href ? '_blank' : undefined}
                rel={c.href ? 'noopener' : undefined}
              >
                <div class="me-mimg">
                  <Frame
                    image={c.image}
                    alt={c.alt}
                    ratio="4 / 3"
                    position={c.position}
                    sizes="(max-width: 899px) 96px, (max-width: 1099px) 30vw, 15vw"
                    widths={[192, 320, 480]}
                  />
                </div>
                <div class="me-mhead">
                  <p class="t-label">{c.label}</p>
                  <h3 class="me-wtitle me-mtitle" set:html={keepCompounds(c.title)} />
                </div>
                <p class="me-mdesc" set:html={keepCompounds(c.desc)} />
              </Tag>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .me-wsec {
    padding: 112px var(--pad) 0;
  }
  .me-wsec-first {
    padding-top: 48px;
  }
  .me-wsec-last {
    padding-bottom: 112px;
  }
  .me-wrule {
    border-top: 1px solid var(--fg);
  }
  .me-wsec-title {
    margin: 12px 0 0;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.012em;
  }
  .me-wcard {
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--fg);
    background: var(--bg);
  }
  a.me-wcard:hover .me-wtitle {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  .me-wtitle {
    margin: 0;
    font-weight: 400;
    color: var(--fg);
    text-wrap: balance;
  }

  /* Highlights: big cards, image over words. */
  .me-hgrid {
    margin-top: 28px;
    display: grid;
    gap: 20px;
  }
  .me-hcard {
    display: block;
    padding-bottom: 12px;
  }
  .me-hlabel,
  .me-htitle,
  .me-hdesc {
    padding: 0 12px;
  }
  .me-hlabel {
    margin-top: 16px;
  }
  .me-htitle {
    margin-top: 8px;
    font-size: 26px;
    line-height: 1.12;
    letter-spacing: -0.012em;
  }
  .me-hdesc {
    margin: 7.6px 0 0;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: var(--fg85);
    text-wrap: pretty;
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .me-hgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* More: a thumbnail beside the label and title, the words under them. */
  .me-mgrid {
    margin-top: 28px;
    display: grid;
    gap: 20px;
  }
  .me-mcard {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
    padding: 12px;
  }
  .me-mhead {
    margin-top: -3.14px;
  }
  .me-mtitle {
    margin-top: 8px;
    font-size: 22px;
    line-height: 1.18;
    letter-spacing: -0.008em;
  }
  .me-mdesc {
    grid-column: 1 / -1;
    margin: 16px 0 0;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: var(--fg85);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .me-wsec {
      padding-top: clamp(128px, 13.333vw, 192px);
    }
    .me-wsec-first {
      padding-top: clamp(72px, 7.222vw, 104px);
    }
    .me-wsec-last {
      padding-bottom: clamp(128px, 13.333vw, 192px);
    }
    .me-wsec-title {
      margin-top: 16px;
      font-size: 36px;
      letter-spacing: -0.014em;
    }

    .me-hgrid {
      margin-top: 48px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: 0;
    }
    .me-hcard {
      grid-column: span 3;
      grid-row: span 4;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
      padding-bottom: 0;
    }
    .me-hlabel,
    .me-htitle,
    .me-hdesc {
      padding: 0 20px;
    }
    .me-hlabel {
      margin-top: 20px;
    }
    .me-htitle {
      margin-top: 10px;
      line-height: 1.14;
      letter-spacing: -0.01em;
    }
    .me-hdesc {
      margin-top: 4.52px;
      padding-bottom: 20px;
      font-size: 17px;
      line-height: 1.65;
      letter-spacing: 0.01em;
    }

    .me-mgrid {
      margin-top: 48px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: var(--gap);
    }
    .me-mcard {
      grid-column: span 6;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: var(--gap);
      padding: 20px;
    }
    .me-mimg {
      grid-column: 1 / span 2;
      grid-row: 1 / span 2;
    }
    .me-mhead {
      grid-column: 3 / span 4;
      margin-top: -3.42px;
    }
    .me-mtitle {
      margin-top: 10px;
      font-size: 24px;
      line-height: 1.16;
    }
    .me-mdesc {
      grid-column: 3 / span 4;
      margin-top: 2.32px;
      font-size: 17px;
      line-height: 1.65;
      letter-spacing: 0.01em;
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .me-hcard {
      grid-column: span 6;
    }
    /* The second pair's gap goes on the cards, not the grid: a row gap there
       would also open between the rows each card shares (subgrid). */
    .me-hcard:nth-child(n + 3) {
      margin-top: var(--gap);
    }
  }
  @media (min-width: 900px) and (max-width: 1099px) {
    .me-mcard {
      grid-column: span 12;
    }
  }
</style>
