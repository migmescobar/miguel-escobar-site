const sections = [
  { id: 'editorial', half: 'is-editorial', title: 'Editorial', cards: editorial },
  { id: 'advertising', half: 'is-brand', title: 'Advertising', cards: advertising },
];

// Between the two sections.
const THROUGH = words(
  'The throughlines across my work are | *clear* communication, *cultural* | attunement, and *human* storytelling.'
);
---

<BaseLayout
  title="Work — Miguel Escobar"
  description="Selected work by Miguel Escobar — features for Esquire Philippines, campaigns for Trust Bank and the NBA, and launch content for Singapore’s Online Safety Commission and IMDA."
>
  <div class="pg wrap">
    <div class="pg-col">
      <h1 class="t-title pg-title" data-rise set:html={rise('Some work')} />
      {
        sections.map((s, si) => (
          <Fragment>
            {si > 0 && (
              <div class="wthrough words" data-words style={`--n: ${THROUGH.n};`}>
                <p class="t-state" set:html={THROUGH.html} />
              </div>
            )}
            <section id={s.id} class:list={['wsec', s.half]} aria-labelledby={`${s.id}-h`}>
              <div class="rule wsec-rule" />
              <h2 id={`${s.id}-h`} class="t-state wsec-title" data-rise set:html={rise(s.title)} />
              <div class="rule-h wsec-heavy" />
              <div class="wgrid">
                {s.cards.map((c, i) => {
                  // The whole card links, unless its copy carries its own links.
                  const Tag = c.href ? 'a' : 'div';
                  return (
                    <Tag
                      class="wcard"
                      href={c.href}
                      target={c.href ? '_blank' : undefined}
                      rel={c.href ? 'noopener' : undefined}
                      data-rv
                      style={`--d: ${i % 4};`}
                    >
                      <Frame
                        image={c.image}
                        alt={c.alt}
                        ratio="4 / 3"
                        position={c.position}
                        sizes="(max-width: 599px) 90vw, (max-width: 899px) 45vw, (max-width: 1199px) 25vw, 18vw"
                        widths={[320, 480, 640, 960]}
                      />
                      <p class="t-small wcard-label">{c.label}</p>
                      <h3 class="t-lead wcard-title" set:html={keepCompounds(c.title)} />
                      <p class="t-body wcard-desc" set:html={keepCompounds(c.desc)} />
                    </Tag>
                  );
                })}
              </div>
            </section>
          </Fragment>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style is:global>
  .wsec-rule {
    margin-top: 64px;
  }
  .pg-title + .wsec .wsec-rule {
    margin-top: calc(80px - var(--s-title) * (0.94 - 0.714) / 2);
  }
  /* The section's name in capitals, centred between a hairline and a heavy rule. */
  .wsec-title {
    margin-top: calc(28px - var(--trim));
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-feature-settings: 'case';
  }
  .wsec-heavy {
    margin-top: calc(28px - var(--trim-s));
  }
  .wgrid {
    --wg: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px var(--wg);
    margin-top: 28px;
  }
  .wcard {
    position: relative;
    display: block;
    padding-bottom: 8px;
    text-decoration: none;
  }
  /* The hairline between columns, drawn down as the card arrives. */
  .wcard::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--wg) / -2);
    width: var(--hair);
    background: var(--ink);
    transform-origin: 50% 0;
    transition: transform 1.3s var(--ease);
    display: none;
  }
  .js .wcard[data-rv]:not(.is-in)::before {
    transform: scaleY(0);
  }
  .wcard .frame img {
    transition: transform 1.2s var(--ease);
  }
  @media (hover: hover) and (min-width: 900px) {
    a.wcard:hover .frame img {
      transform: scale(1.035);
    }
  }
  .wcard-label {
    margin-top: calc(20px - var(--trim));
    color: var(--accent, var(--grey));
  }
  .wcard-title {
    --trim: calc(var(--s-card) * (var(--lh) - 0.71) / 2);
    margin-top: calc(16px - 8px * (1.2 - 0.714) / 2 - var(--trim));
    font-size: var(--s-card);
    text-wrap: balance;
  }
  a.wcard:hover .wcard-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  /* Set close, on 20. */
  .wcard-desc {
    --trim: 4.32px;
    margin-top: calc(16px - var(--s-card) * (1.25 - 0.71) / 2 - var(--trim));
    line-height: 20px;
    text-wrap: pretty;
  }
  /* The throughlines: the phone's headline size, the statement size on the desktop. */
  .wthrough {
    --s-state: var(--s-head);
    --trim-s: calc(var(--s-state) * 0.23);
    margin: calc(96px - var(--trim-s)) auto calc(72px - var(--trim-s));
    max-width: 16.5em;
    font-size: var(--s-state);
    text-align: center;
  }
  @media (min-width: 600px) {
    .wgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wcard:nth-child(2n)::before {
      display: block;
    }
  }
  @media (min-width: 900px) {
    .wgrid {
      --wg: 36px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 24px;
    }
    .wcard:nth-child(2n)::before {
      display: none;
    }
    .wcard:not(:nth-child(3n + 1))::before {
      display: block;
    }
    .wthrough {
      margin: calc(2 * var(--pitch) - var(--trim-s)) auto calc(1.5 * var(--pitch) - var(--trim-s));
    }
  }
  @media (min-width: 1200px) {
    .wgrid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .wcard:not(:nth-child(3n + 1))::before {
      display: none;
    }
    .wcard:not(:nth-child(4n + 1))::before {
      display: block;
    }
  }
</style>
