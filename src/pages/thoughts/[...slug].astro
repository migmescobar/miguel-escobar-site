---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Frame from '../../components/Frame.astro';
import { bindWords, parseTitleParts, plainTitle } from '../../utils/postTitle';

export async function getStaticPaths() {
  // Drafts are excluded here too, so a draft never gets a built page.
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLong = post.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const dateISO = post.data.pubDate.toISOString();
const titlePlain = plainTitle(post.data.title);
// A title that opens on a quote mark hangs it in the margin, so the words align.
const hang = /^[“‘"']/.test(titlePlain);

// Search results cut titles around 60 characters. Keep the brand suffix when it
// fits and drop it when it doesn't, so a long headline isn't truncated mid-word
// and the useful words survive.
const SUFFIX = ' — Miguel Escobar';
const pageTitle =
  (titlePlain + SUFFIX).length <= 60 ? `${titlePlain}${SUFFIX}` : titlePlain;
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  type="article"
  publishedTime={dateISO}
  articleHeadline={titlePlain}
  image={`/og/thoughts/${post.id}.png`}
>
  <article class="pg wrap post">
    <div class="pg-col">
      <header class="post-head">
        <h1 class:list={['t-state post-title', { 'post-hang': hang }]} data-rv>
          {parseTitleParts(post.data.title).map((p) => (p.em ? <em>{bindWords(p.text)}</em> : bindWords(p.text)))}
        </h1>
        <p class="t-lead post-deck" data-rv>{post.data.description}</p>
        <div class="rule post-rule" data-rv></div>
        <p class="post-date" data-rv><time datetime={dateISO.slice(0, 10)}>{dateLong}</time></p>
      </header>
      {
        post.data.heroImage && (
          <Frame
            class="post-hero"
            image={post.data.heroImage}
            alt={post.data.heroAlt ?? titlePlain}
            ratio="16 / 9"
            loading="eager"
            sizes="(max-width: 899px) 92vw, 45vw"
            widths={[560, 900, 1280]}
            quality={90}
          />
        )
      }
      <div class="post-body prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* The headline at the phone's headline size (32px), the statement size on the
     desktop; the deck under it; then a hairline and the date. A post stands in
     columns 6–15. */
  .post-head {
    --s-state: var(--s-head);
    --trim-s: calc(var(--s-state) * 0.23);
  }
  .post-title {
    max-width: 16em;
    text-wrap: balance;
  }
  .post-title em {
    font-style: italic;
  }
  .post-hang {
    text-indent: -0.4em;
  }
  .post-deck {
    margin-top: calc(28px - var(--trim-s) - var(--trim));
    text-wrap: pretty;
  }
  .post-rule {
    margin-top: calc(40px - var(--s-lead) * (1.25 - 0.71) / 2);
  }
  .post-date {
    margin-top: 13.57px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-feature-settings: 'case';
  }
  .post-hero {
    margin-top: 40px;
  }
  .post-body {
    margin-top: 47.25px;
  }
  @media (min-width: 900px) {
    .post.pg {
      padding-top: calc(85px - var(--trim-s));
    }
    .post .pg-col {
      margin-inline: calc((100% + var(--g)) * 5 / 20);
    }
  }

  /* Prose (Markdown output). */
  .prose {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.03em;
  }
  .prose p {
    margin: 0 0 1.5em;
  }
  .prose > :last-child {
    margin-bottom: 0;
  }
  .prose em {
    font-style: italic;
  }
  .prose a {
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .prose a:hover {
    text-decoration-color: currentColor;
  }
  .prose h2 {
    margin: 2em 0 0.75em;
    font-size: var(--s-lead);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .prose h3 {
    margin: 1.5em 0 0.5em;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .prose ul,
  .prose ol {
    margin: 0 0 1.5em;
    padding-left: 1.3em;
  }
  .prose li {
    margin: 0.3em 0;
  }
  .prose blockquote {
    margin: 1.5em 0;
    padding-left: 1.1em;
    border-left: var(--heavy) solid var(--ink);
  }
  .prose hr {
    border: 0;
    border-top: var(--hair) solid var(--ink);
    margin: 2em 0;
  }
  .prose img {
    width: 100%;
    height: auto;
    margin: 1.5em 0;
  }
  .prose code {
    font-size: 0.9em;
    background: var(--white);
    padding: 0.1em 0.35em;
  }
  .prose pre {
    overflow: auto;
    padding: 1em;
    background: var(--white);
    margin: 0 0 1.5em;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
</style>
