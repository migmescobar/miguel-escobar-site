---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkImage from '../../components/WorkImage.astro';
import { parseTitleParts, plainTitle } from '../../utils/postTitle';

export async function getStaticPaths() {
  // Drafts are excluded here too, so a draft never gets a built page.
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLong = post.data.pubDate
  .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .toUpperCase();
const dateISO = post.data.pubDate.toISOString();
const titlePlain = plainTitle(post.data.title);

// Search results cut titles around 60 characters. Keep the brand suffix when it
// fits and drop it when it doesn't, so a long headline isn't truncated mid-word
// and the useful words survive.
const SUFFIX = ' — Miguel Escobar';
const pageTitle =
  (titlePlain + SUFFIX).length <= 60 ? `${titlePlain}${SUFFIX}` : titlePlain;
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  type="article"
  publishedTime={dateISO}
  articleHeadline={titlePlain}
  image={`/og/thoughts/${post.id}.png`}
>
  <article class="post">
    <header class="post-head" data-reveal>
      <div class="eyebrow"><time datetime={dateISO}>{dateLong}</time></div>
      <h1>{parseTitleParts(post.data.title).map((p) => (p.em ? <em>{p.text}</em> : p.text))}</h1>
      <p class="deck">{post.data.description}</p>
    </header>

    {
      post.data.heroImage && (
        <div class="hero" data-reveal>
          <WorkImage
            image={post.data.heroImage}
            alt={post.data.heroAlt ?? titlePlain}
            ratio="16 / 9"
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 760px) 92vw, 720px"
            widths={[560, 900, 1280]}
            quality={90}
          />
        </div>
      )
    }

    <div class="body" data-reveal>
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-head {
    padding: clamp(40px, 7vh, 84px) 0 clamp(30px, 3.6vw, 42px);
  }
  /* line-height:1 is what makes the gap below the date read correctly — the
     mono block's default leading otherwise adds invisible space above the H1. */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.105em;
    /* Hand-off says .5; darkened to clear AA at this size (see global.css). */
    color: var(--ink-mute);
    margin-bottom: clamp(16px, 1.7vw, 22px);
  }
  .post-head h1 {
    margin: 0 0 clamp(16px, 1.9vw, 24px);
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.007em;
    text-wrap: balance;
  }
  .deck {
    margin: 0;
    font-size: clamp(19px, 1.9vw, 23px);
    line-height: 1.45;
    letter-spacing: 0.009em;
    color: var(--ink-70);
    text-wrap: pretty;
  }

  .hero {
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .body {
    border-top: 1px solid var(--ink-30);
    padding-top: clamp(28px, 4vw, 40px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  /* Prose (Markdown output) */
  .body :global(p) {
    margin: 0 0 1.3em;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-90);
    text-wrap: pretty;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .body :global(h2) {
    margin: 1.6em 0 0.5em;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.28;
    letter-spacing: -0.003em;
  }
  .body :global(h3) {
    margin: 1.4em 0 0.4em;
    font-size: 21px;
  }
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1.3em;
    padding-left: 1.3em;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-90);
  }
  .body :global(li) {
    margin: 0.3em 0;
  }
  .body :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 1.1em;
    border-left: 2px solid var(--ink-30);
    color: var(--ink-70);
    font-style: italic;
  }
  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--ink-30);
    margin: 2em 0;
  }
  .body :global(img) {
    width: 100%;
    height: auto;
    margin: 1.4em 0;
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--ink-06);
    padding: 0.15em 0.4em;
  }
  .body :global(pre) {
    overflow: auto;
    padding: 1em;
    background: var(--ink-06);
    margin: 0 0 1.3em;
  }
  .body :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
