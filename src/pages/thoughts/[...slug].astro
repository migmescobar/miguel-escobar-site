---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Frame from '../../components/Frame.astro';
import { bindWords, parseTitleParts, plainTitle } from '../../utils/postTitle';

export async function getStaticPaths() {
  // Drafts are excluded here too, so a draft never gets a built page.
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLong = post.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const dateISO = post.data.pubDate.toISOString();
const titlePlain = plainTitle(post.data.title);
// A title that opens on a quote mark hangs it in the margin, so the words align.
const hang = /^[“‘"']/.test(titlePlain);

// Search results cut titles around 60 characters. Keep the brand suffix when it
// fits and drop it when it doesn't, so a long headline isn't truncated mid-word
// and the useful words survive.
const SUFFIX = ' — Miguel Escobar';
const pageTitle =
  (titlePlain + SUFFIX).length <= 60 ? `${titlePlain}${SUFFIX}` : titlePlain;
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  type="article"
  publishedTime={dateISO}
  articleHeadline={titlePlain}
  image={`/og/thoughts/${post.id}.png`}
  current="thoughts"
>
  <article class="me-post">
    <header class="me-posthead">
      <div class="me-postcol">
        <p class="t-label"><time datetime={dateISO.slice(0, 10)}>{dateLong}</time></p>
        <h1 class:list={['t-h1 me-posttitle', { 'me-hang': hang }]}>
          {parseTitleParts(post.data.title).map((p) => (p.em ? <em>{bindWords(p.text)}</em> : bindWords(p.text)))}
        </h1>
        <p class="t-lead me-deck">{post.data.description}</p>
        {
          post.data.heroImage && (
            <Frame
              class="me-posthero"
              image={post.data.heroImage}
              alt={post.data.heroAlt ?? titlePlain}
              ratio="16 / 9"
              loading="eager"
              sizes="(max-width: 899px) 92vw, 60vw"
              widths={[560, 900, 1280]}
              quality={90}
            />
          )
        }
      </div>
    </header>

    <div class="me-postbody">
      <div class="t-body me-prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .me-posthead {
    padding: 76px var(--pad) 0;
  }
  .me-posttitle {
    margin-top: 22px;
  }
  .me-hang {
    text-indent: -0.3em;
  }
  .me-deck {
    margin: 28px 0 0;
    color: var(--fg75);
  }
  .me-postcol :global(.me-posthero) {
    margin-top: 44px;
  }
  .me-postbody {
    padding: 44px var(--pad) 108px;
  }
  .me-prose {
    color: var(--fg85);
  }
  @media (min-width: 900px) {
    .me-posthead,
    .me-postbody {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }
    .me-posthead {
      padding-top: clamp(96px, 9.03vw, 130px);
    }
    .me-postcol {
      grid-column: 5 / span 8;
    }
    .me-posttitle {
      margin-top: 28px;
    }
    .me-deck {
      margin-top: 40px;
      max-width: 30em;
    }
    .me-postcol :global(.me-posthero) {
      margin-top: 64px;
    }
    .me-postbody {
      padding: clamp(64px, 6.11vw, 88px) var(--pad) clamp(128px, 13.06vw, 188px);
    }
    .me-prose {
      grid-column: 5 / span 5;
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .me-postcol {
      grid-column: 3 / span 10;
    }
    .me-prose {
      grid-column: 3 / span 8;
    }
  }

  /* Prose (Markdown output). */
  .me-prose :global(p) {
    margin: 0 0 1em;
  }
  .me-prose > :global(:last-child) {
    margin-bottom: 0;
  }
  .me-prose :global(a) {
    text-decoration-line: underline;
    text-decoration-color: var(--ul);
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .me-prose :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .me-prose :global(h2) {
    margin: 1.8em 0 0.6em;
    font-size: 28px;
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--fg);
  }
  .me-prose :global(h3) {
    margin: 1.6em 0 0.5em;
    font-size: 22px;
    line-height: 1.18;
    letter-spacing: -0.008em;
    color: var(--fg);
  }
  .me-prose :global(ul),
  .me-prose :global(ol) {
    margin: 0 0 1em;
    padding-left: 1.3em;
  }
  .me-prose :global(li) {
    margin: 0.3em 0;
  }
  .me-prose :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 1.1em;
    border-left: 1px solid var(--fg);
    font-style: italic;
  }
  .me-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 2em 0;
  }
  .me-prose :global(img) {
    width: 100%;
    height: auto;
    margin: 1.4em 0;
  }
  .me-prose :global(code) {
    font-size: 0.9em;
    background: var(--wash);
    padding: 0.1em 0.35em;
  }
  .me-prose :global(pre) {
    overflow: auto;
    padding: 1em;
    background: var(--wash);
    margin: 0 0 1em;
  }
  .me-prose :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
