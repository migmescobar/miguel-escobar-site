---
// Thoughts (boards SkThoughts / SkThoughtsMobile): the published posts, newest
// first, run in as one statement-sized paragraph. Each entry stands in grey, its
// date before it; the one under the pointer comes up in ink, its date with it.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bindWords, parseTitleParts } from '../../utils/postTitle';
import { rise } from '../../utils/text';

// Published posts only (drafts excluded), newest first.
const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateLong = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dateISO = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="Thoughts — Miguel Escobar"
  description="Thoughts by Miguel Escobar on communications, editorial craft, content governance, culture, and tech."
>
  <div class="pg wrap">
    <div class="pg-col">
      <h1 class="t-title pg-title" data-rise set:html={rise('Thoughts')} />
      <div class="rule th-rule"></div>
      {posts.length === 0 && <p class="t-lead th-empty">No posts yet — check back soon.</p>}
      {
        posts.length > 0 && (
          <ol class="t-state runin" data-rv>
            {posts.map((post) => (
              <li class="ri">
                <time class="ri-d" datetime={dateISO(post.data.pubDate)}>
                  {dateLong(post.data.pubDate)}
                </time>{' '}
                <a class="ri-a" href={`/thoughts/${post.id}/`}>
                  {parseTitleParts(post.data.listTitle ?? post.data.title).map((p) =>
                    p.em ? <em>{bindWords(p.text)}</em> : bindWords(p.text)
                  )}
                </a>{' '}
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </div>
</BaseLayout>

<style is:global>
  .th-rule {
    margin-top: calc(48px - var(--s-title) * (0.94 - 0.714) / 2);
  }
  .th-empty {
    margin-top: 24px;
  }
  .runin {
    margin: calc(24px - var(--trim)) 0 0;
    padding: 0;
    list-style: none;
    text-indent: 1.5em;
    text-wrap: pretty;
  }
  .ri {
    display: inline;
  }
  .ri-a,
  .ri-d {
    color: var(--grey);
    transition: color 0.35s ease;
  }
  .ri-a {
    text-decoration: none;
  }
  .ri:hover .ri-a,
  .ri:hover .ri-d,
  .ri:focus-within .ri-a,
  .ri:focus-within .ri-d {
    color: var(--ink);
  }
  a.ri-a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  /* The date: a label, centred on the statement's x-height. */
  .ri-d {
    display: inline-block;
    margin-right: 0.3em;
    text-indent: 0;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-feature-settings: 'case';
    white-space: nowrap;
    vertical-align: calc(var(--s-state) * 0.71 / 2 - 10px * 0.714 / 2);
  }
  @media (min-width: 900px) {
    .th-rule {
      margin-top: calc(80px - var(--s-title) * (0.94 - 0.714) / 2);
    }
    .runin {
      margin-top: calc(32px - var(--trim));
      text-indent: 25%;
    }
  }
</style>
