---
// Thoughts (boards NewThoughts*): the published posts, newest first, each a
// headline that comes up to full ink on hover.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bindWords, parseTitleParts } from '../../utils/postTitle';

// Published posts only (drafts excluded), newest first.
const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).toUpperCase();
const yearMonth = (d: Date) => d.toISOString().slice(0, 7);
---

<BaseLayout
  title="Thoughts — Miguel Escobar"
  description="Thoughts by Miguel Escobar on communications, editorial craft, content governance, culture, and tech."
  current="thoughts"
>
  <section class="me-thoughts">
    <div class="me-pagehead me-pagehead-flush">
      <h1 class="t-xl me-pagetitle">Thoughts</h1>
      <p class="t-lead me-pagesub">Where I’m at on media, culture, and issues of the day</p>
    </div>

    <div class="me-entries">
      {posts.length === 0 && <p class="t-lead me-empty">No posts yet — check back soon.</p>}
      {
        posts.map((post) => (
          <a class="me-entry" href={`/thoughts/${post.id}/`}>
            <time class="t-label" datetime={yearMonth(post.data.pubDate)}>
              {monthYear(post.data.pubDate)}
            </time>
            <h2 class="t-h1 me-entry-title">
              {parseTitleParts(post.data.listTitle ?? post.data.title).map((p) =>
                p.em ? <em>{bindWords(p.text)}</em> : bindWords(p.text)
              )}
            </h2>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .me-thoughts {
    padding: 0 0 112px;
  }
  .me-pagehead-flush {
    padding-bottom: 0;
  }
  .me-entries {
    margin: 48px var(--pad) 0;
    border-top: var(--heavy) solid var(--fg);
  }
  .me-empty {
    margin: 24px 0 0;
    color: var(--fg75);
  }
  .me-entry {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 0 28px;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .me-entry-title {
    opacity: 0.62;
    transition: opacity 0.35s ease;
  }
  .me-entry:hover .me-entry-title,
  .me-entry:focus-visible .me-entry-title {
    opacity: 1;
  }
  @media (min-width: 900px) {
    .me-thoughts {
      padding-bottom: clamp(128px, 13.333vw, 192px);
    }
    .me-entries {
      margin-top: clamp(72px, 7.222vw, 104px);
    }
    .me-entry {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: baseline;
      padding: 40px 0 46px;
    }
    .me-entry time {
      grid-column: 1 / span 2;
    }
    .me-entry-title {
      grid-column: 7 / span 6;
    }
  }
</style>
