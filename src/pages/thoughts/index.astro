---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { parseTitleParts } from '../../utils/postTitle';

// Published posts only (drafts excluded), newest first.
const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase();
---

<BaseLayout
  title="Thoughts — Miguel Escobar"
  description="Thoughts by Miguel Escobar on communications, editorial craft, content governance, culture, and tech."
>
  <div class="wrap">
    <PageHead title="Thoughts" subhead="Where I’m at on media, culture, and issues of the day" />

    <section class="index" data-reveal>
      {
        posts.length > 0 ? (
          <p class="entries">
            {posts.map((post) => (
              <>
                <span class="date">{monthYear(post.data.pubDate)}</span>
                <a href={`/thoughts/${post.id}/`}>{parseTitleParts(post.data.listTitle ?? post.data.title).map((p) => (p.em ? <em>{p.text}</em> : p.text))}</a>{' '}
              </>
            ))}
          </p>
        ) : (
          <p class="empty">No posts yet — check back soon.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .index {
    border-top: 1px solid var(--ink-30);
    padding: clamp(32px, 4vw, 56px) 0 clamp(64px, 10vw, 140px);
  }
  .entries {
    margin: 0;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.014em;
    text-wrap: pretty;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.3em;
    font-weight: 500;
    letter-spacing: 0.1em;
    vertical-align: 0.62em;
    /* Hand-off says .5; darkened to clear AA at this small size. */
    color: var(--ink-mute);
    margin-right: 1.2em;
    white-space: nowrap;
  }
  /* Dim until hover — a display list, not body copy. The hand-off's .3 resting
     value fails AA even for large text, so this uses .5, which keeps the effect
     and clears the 3:1 large-text threshold. Focus also lifts it to full ink,
     which the hand-off flagged as worth doing. */
  .entries a {
    text-decoration: none;
    color: var(--ink-dormant);
    transition: color 0.35s ease;
  }
  .entries a:hover,
  .entries a:focus-visible {
    color: var(--ink);
  }
  .empty {
    margin: 0;
    font-size: 16px;
    color: var(--ink-90);
  }
</style>
