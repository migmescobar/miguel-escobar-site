---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
---

<BaseLayout
  title="About — Miguel Escobar"
  description="Singapore-based creative communications professional with a deep editorial background — editorial, content operations, and strategy across APAC."
>
  <div class="wrap">
    <PageHead
      title="Editorial instincts and creative acuity, rewired for the scale and stakes of tech"
    />

    <section class="bio-section" data-reveal>
      <div class="bio">
        <p>
          I’m a Singapore-based creative communications professional with a deep editorial
          background. Perpetually curious, plugged into news and culture, and cautiously AI-pilled.
        </p>
        <p>
          At Esquire magazine, I covered culture, politics, and current affairs, writing, producing,
          and editing everything from daily articles to investigative features. Over 12 years I’ve
          moved across editorial, content operations, and strategic communications, working with
          brands like the NBA, Trust Bank, and Samsung across the Philippines and Singapore. I’ve
          managed high-volume content projects, enforced editorial standards across several
          publications, and built communications strategies and content governance frameworks for
          brands.
        </p>
        <p>
          Now I’m learning full-stack programming at the National University of Singapore (NUS) with
          a view to applying my editorial skills in a more tech-forward context.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The bio sits right-aligned in the grid so it reads opposite the H1's
     left-hand mass. */
  .bio-section {
    padding: 0 0 clamp(48px, 7vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: end;
  }
  .bio {
    max-width: 64ch;
    justify-self: end;
    font-size: clamp(17px, 1.55vw, 20px);
    line-height: 1.58;
    letter-spacing: 0.004em;
  }
  .bio p {
    margin: 0 0 1.3em;
  }
  .bio p:last-child {
    margin: 0;
  }
</style>
