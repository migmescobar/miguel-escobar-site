---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import WorkImage from '../components/WorkImage.astro';
import PageHead from '../components/PageHead.astro';

import trust from '../assets/images/ads_trust.png';
import nba from '../assets/images/ads_nba.png';
import alcon from '../assets/images/ads_alcon.png';
import gotyme from '../assets/images/ads_gotyme.png';

const imgSizes = '(max-width: 760px) 92vw, 620px';
const imgWidths = [480, 800, 1240];
const imgQuality = 80;
---

<BaseLayout
  title="Advertising Work — Miguel Escobar"
  description="Selected advertising work by Miguel Escobar — campaigns and copy for Trust Bank, the NBA, Alcon, and GoTyme."
>
  <div class="wrap">
    <PageHead title="Advertising Work" />

    <WorkRow>
      <Fragment slot="text">
        <h2>Trust Bank Singapore</h2>
        <p>
          Since the 2022 launch of Trust Bank, a digital bank in Singapore, I’ve worked on its
          campaigns and always-on social. That includes creative leadership for the award-winning 2024
          <a
            href="https://www.marketing-interactive.com/trust-bank-million-dollars-campaign"
            target="_blank"
            rel="noopener">launch of its cashback card</a> — an above-the-line campaign involving <a
            href="https://www.youtube.com/watch?v=nhxvOzenBR4"
            target="_blank"
            rel="noopener">a film</a> and islandwide out-of-home.
        </p>
      </Fragment>
      <WorkImage
        slot="media"
        image={trust}
        alt="A woman laughing as Singapore dollar notes and gold confetti rain around her, holding up a Trust Bank cashback card."
        ratio="4 / 3"
        sizes={imgSizes}
        widths={imgWidths}
        quality={imgQuality}
      />
    </WorkRow>

    <WorkRow>
      <Fragment slot="text">
        <h2>NBA Asia-Pacific Newsletters</h2>
        <p>
          I write copy for the weekly newsletters and direct mailers of the NBA in key Asia-Pacific
          territories: Australia, New Zealand, Japan, and the Philippines. Day-to-day work for this
          involves the application of cultural fluency and market-specific strategies to drive
          click-through.
        </p>
      </Fragment>
      <WorkImage
        slot="media"
        image={nba}
        alt="A dramatic NBA promotional collage of San Antonio Spurs and New York Knicks players over city skylines, with a golden basketball."
        ratio="4 / 3"
        sizes={imgSizes}
        widths={imgWidths}
        quality={imgQuality}
      />
    </WorkRow>

    <WorkRow>
      <Fragment slot="text">
        <h2>Alcon Asia-Pacific Campaigns</h2>
        <p>
          I worked on the regional launch campaigns of Precision1 and Total — contact lens brands by
          the global pharmaceutical and eye care company Alcon. These involved productions in South
          Korea and Vietnam, for materials that would be used across Asia and beyond.
        </p>
      </Fragment>
      <WorkImage
        slot="media"
        image={alcon}
        alt="A woman working at a laptop in a warm-lit, elegant dark-blue office with abstract art behind her, from an Alcon campaign."
        ratio="4 / 3"
        sizes={imgSizes}
        widths={imgWidths}
        quality={imgQuality}
      />
    </WorkRow>

    <WorkRow last>
      <Fragment slot="text">
        <h2>GoTyme Bank Philippines</h2>
        <p>
          I worked on copy and concept for the 2023 launch campaign of GoTyme Bank, a digital bank in
          the Philippines. Its unique proposition is the human quality of its customer service, so the
          campaign reflected that, mainly through its <a
            href="https://www.youtube.com/watch?v=MCDe-yLaxYE"
            target="_blank"
            rel="noopener">campaign film</a> and a trio of <a
            href="https://www.youtube.com/watch?v=yBnokrkGRbM"
            target="_blank"
            rel="noopener">shorts</a>.
        </p>
      </Fragment>
      <WorkImage
        slot="media"
        image={gotyme}
        alt="A grinning presenter in a suit points to a framed portrait of a man held up before a seated audience, from the GoTyme Bank campaign film."
        ratio="4 / 3"
        sizes={imgSizes}
        widths={imgWidths}
        quality={imgQuality}
      />
    </WorkRow>
  </div>
</BaseLayout>

