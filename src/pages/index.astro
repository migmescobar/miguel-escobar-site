---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkImage from '../components/WorkImage.astro';
import { SITE_DESCRIPTION } from '../consts';

// Home "Some work" cards, in display order. OSC + Age Checks have no public URL
// yet, so they render as plain (unlinked) headings; Whitewash & Pulpit keep their
// published Esquire links.
import osc from '../assets/images/home_osc.png';
import ageChecks from '../assets/images/home_age_checks.png';
import whitewash from '../assets/images/home_whitewash.png';
import pulpit from '../assets/images/home_pulpit.png';
import advertising from '../assets/images/home_advertising.png';
import editorial from '../assets/images/home_editorial.png';

const cards = [
  {
    title: 'Online Safety Commission Launch Content',
    href: 'https://www.osc.gov.sg/',
    blurb:
      'Web copy, service articles, and explainer videos about online harms for the launch of Singapore’s Online Safety Commission',
    image: osc,
    alt: 'A young person absorbed in a phone screen — from the launch of Singapore’s Online Safety Commission.',
  },
  {
    title: 'Age Checks Matter',
    href: 'https://www.imda.gov.sg/how-we-can-help/age-assurance',
    blurb:
      'A campaign — including outdoor ads, a film, and an explainer video — for Singapore’s IMDA, launching Age Assurance Measures in app stores',
    image: ageChecks,
    alt: 'A shopkeeper raising her hand to a boy holding beer beneath an “Under 18” sign, from the Age Assurance Measures campaign',
  },
  {
    title: 'How to Whitewash a Dictator',
    href: 'https://www.esquiremag.ph/politics/opinion/fighting-for-history-on-the-wikipedia-battlefield-a00207-20170817-lfrm2',
    blurb:
      'An investigative feature for Esquire Philippines, on an invisible war for Philippine history waged by Wikipedia editors on hotly contested pages',
    image: whitewash,
    alt: 'Ferdinand Marcos collaged over a redacted Wikipedia “Martial law” article, for “How to Whitewash a Dictator”',
  },
  {
    title: 'A Pulpit for Pastors of Porn',
    href: 'https://www.esquiremag.ph/long-reads/notes-and-essays/the-rise-of-pastor-culture-and-why-it-must-end-a1513-20170629-lfrm',
    blurb:
      'An Esquire Philippines exposé that shed light on a social media subculture of sexual predators in the Philippines, sparking a nationwide reckoning',
    image: pulpit,
    alt: 'Halftone hands reaching toward pixelated images inside retro computer windows, for “A Pulpit for Pastors of Porn.”',
  },
  {
    title: 'More Advertising Work',
    href: '/advertising-work/',
    blurb:
      'A selection of ads and campaigns I’ve worked on, including for the NBA, Trust Bank, and Alcon',
    image: advertising,
    alt: 'A woman laughing behind a Trust cashback Visa card as banknotes rain down.',
  },
  {
    title: 'More Editorial Work',
    href: '/editorial-work/',
    blurb:
      'A selection of stories I wrote and produced for Esquire Philippines, Tatler Asia, and Smile Magazine',
    image: editorial,
    alt: 'A dramatic, low-key editorial portrait of an older man against a black background.',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title="Miguel Escobar — Strategic Communications & Editorial" description={SITE_DESCRIPTION} personSchema>
  <section class="hero wrap">
    <h1 class="hero-name">Miguel<br />Escobar</h1>
    <div class="hero-rule"></div>
    <div class="hero-grid">
      <p class="positioning">
        Strategic Communications. Content Governance. Editorial Operations. APAC&nbsp;Markets.
      </p>
      <div class="bio">
        <p>
          A Singapore-based communications professional with a journalist’s instincts. Perpetually
          curious, plugged into tech and culture, terminally online, and judiciously AI-pilled.
        </p>
        <p>
          At Esquire Philippines, I covered culture, politics, and current affairs, writing, producing,
          and editing everything from daily articles to investigative features. Over 12 years I’ve moved
          across editorial, content operations, and strategic communications, working with brands like the
          NBA, Trust Bank, and Samsung across the Philippines and Singapore. I’ve managed
          high-volume content projects, enforced editorial standards across several publications, and built
          communications strategies and content governance frameworks for brands.
        </p>
        <p>
          Now I’m learning code at the National University of Singapore (NUS) with a view to applying my editorial skills in a more tech-forward context.
        </p>
      </div>
    </div>
  </section>

  <div class="wrap rule"></div>

  <section class="work wrap">
    <div class="work-head" data-reveal>
      <h2>Some work</h2>
    </div>
    <div class="grid">
      {
        cards.map((card) => (
          <article class="card" data-reveal>
            <WorkImage
              image={card.image}
              alt={card.alt}
              ratio="3 / 4"
              sizes="(max-width: 640px) 92vw, (max-width: 1080px) 45vw, 320px"
              widths={[320, 480, 760]}
            />
            <h3>
              {card.href ? (
                <a
                  href={card.href}
                  target={isExternal(card.href) ? '_blank' : undefined}
                  rel={isExternal(card.href) ? 'noopener' : undefined}
                >
                  {card.title}
                </a>
              ) : (
                card.title
              )}
            </h3>
            <p>{card.blurb}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(40px, 8vh, 96px) 0 clamp(48px, 7vw, 96px);
  }
  .hero-name {
    margin: 0 0 clamp(28px, 4vw, 48px);
    font-family: var(--font-serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(54px, 11vw, 164px);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .hero-rule {
    height: 1px;
    background: var(--ink);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .positioning {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.28;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .bio {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.65;
    /* Optical baseline nudge: the 34px positioning line and the 17px bio start at
       the same y, so the smaller column reads as sitting high. Desktop only. */
    padding-top: 7px;
  }
  .bio p {
    margin: 0 0 1.4em;
  }
  /* No trailing space under the bio column, whichever paragraph ends it. Was
     tied to a .last class that no longer exists in the markup. */
  .bio p:last-child {
    margin: 0;
  }

  .work {
    padding: clamp(40px, 6vw, 72px) 0 clamp(64px, 9vw, 128px);
  }
  .work-head {
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .work-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(42px, 5.8vw, 80px);
    letter-spacing: -0.008em;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: clamp(40px, 4vw, 56px);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card h3 {
    margin: 0;
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-80);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .hero-name {
      font-size: clamp(62px, 23vw, 92px);
      line-height: 1.04;
    }
    .bio {
      padding-top: 0;
    }
  }
</style>
