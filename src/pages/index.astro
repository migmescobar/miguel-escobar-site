---
// Home: one continuous scroll (boards NewHome*/NewHomePlay*). The hero's statement
// types itself in and the name rises; then Work (a rail of samples), About (the map),
// Editorial beside Branded (the highlights reel), the pinned Policy stage, the footer.
// Motion is in src/styles/home.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import Typed from '../components/Typed.astro';
import Frame from '../components/Frame.astro';
import { SITE_DESCRIPTION } from '../consts';
import { typeChars, keepCompounds } from '../utils/typed';
import '../styles/home.css';
import '../styles/riso.css';

import mapDesktop from '../assets/map/map-desktop.svg.html?raw';
import mapMobile from '../assets/map/map-mobile.svg.html?raw';

import trust from '../assets/images/home-advertising.jpg';
import ageChecks from '../assets/images/home-age-checks.jpg';
import eddie from '../assets/images/home-editorial.jpg';
import whitewash from '../assets/images/home-whitewash.jpg';
import osc from '../assets/images/osc-phone-57.jpg';
import nba from '../assets/images/ads-nba.jpg';
import pulpit from '../assets/images/home-pulpit.jpg';
import uson from '../assets/images/ph-politics-uson.jpg';
import magazines from '../assets/images/editorial-magazines.webp';

const STATEMENT = 'Editorial instincts and creative acuity for the scale and stakes of tech.';
const WORK_HEAD = 'My work has been about honest, helpful, human storytelling.';

// The samples on the rail (after Monocle's rails).
const rail = [
  {
    href: 'https://www.marketing-interactive.com/trust-bank-million-dollars-campaign',
    image: trust,
    alt: 'A woman laughing, a Trust cashback Visa card held over one eye, as banknotes and confetti rain down.',
    label: 'Fintech Campaign',
    title: 'Trust Bank Singapore: Cashback Launch',
  },
  {
    href: 'https://www.youtube.com/watch?v=HXkZmhEBnBQ',
    image: ageChecks,
    alt: 'A shopkeeper raising her hand to a boy holding beer beneath an “Under 18” sign, from the Age Assurance Measures campaign',
    label: 'Public Service',
    title: 'Age Assurance Measures in App Stores',
  },
  {
    href: 'https://www.youtube.com/watch?v=yY4LLYrMHt8',
    image: eddie,
    alt: 'A dramatic, low-key editorial portrait of an older man against a black background.',
    label: 'Cover Story',
    title: 'Eddie Garcia for Esquire Philippines',
  },
  {
    href: 'https://www.esquiremag.ph/politics/opinion/fighting-for-history-on-the-wikipedia-battlefield-a00207-20170817-lfrm2',
    image: whitewash,
    alt: 'Ferdinand Marcos collaged over a redacted Wikipedia “Martial law” article, for “How to Whitewash a Dictator”',
    label: 'Investigative Feature',
    title: 'The\u00a0Wikipedians at War Over Truth',
  },
  {
    href: 'https://www.osc.gov.sg/',
    image: osc,
    alt: 'A hand in the dark, lit by the glow of a phone screen.',
    label: 'Public Service',
    title: 'Online Safety Commission Launch',
  },
  {
    href: '/work/#advertising',
    image: nba,
    alt: 'A dramatic NBA promotional collage of San Antonio Spurs and New York Knicks players over city skylines, with a golden basketball.',
    label: 'Branded Newsletter',
    title: 'NBA Asia-Pacific Weeklies',
  },
  {
    href: 'https://www.esquiremag.ph/long-reads/notes-and-essays/the-rise-of-pastor-culture-and-why-it-must-end-a1513-20170629-lfrm',
    image: pulpit,
    alt: 'Halftone hands reaching toward pixelated images inside retro computer windows, for “A Pulpit for Pastors of Porn.”',
    label: 'Investigative Feature',
    title: 'Exposing Intimate Image Abuse Groups',
  },
  {
    href: '/work/#editorial',
    image: uson,
    alt: 'Mocha Uson in a black coat, her mouth covered with a strip of grey tape.',
    label: 'Politics',
    title: 'Interviews With Controversial Figures',
  },
];
const ext = (href: string) => href.startsWith('http');

const ABOUT = {
  head: 'I’m based in Singapore with regional scope.',
  emph: 'Singapore',
  body: 'I moved here from Manila and have since worked agency-side, on local and APAC-wide campaigns for clients including the NBA, Trust Bank, and the IMDA.',
};
const EDITORIAL = {
  head: 'My editorial background informs everything I do.',
  emph: 'editorial background',
  body: 'In Manila, I was an editor at the local edition of Esquire magazine, covering culture, politics, and current affairs. This formative chapter of my career is a core memory — it gave me a journalistic perspective that I’ve since applied in everything I do.',
};
const BRANDED = {
  head: 'But the bigger chunk of my career has been in branded content.',
  emph: 'branded content',
  body: 'Of my 12 years of experience, 10 have been in roles handling advertorials and brand campaigns. My strategic communication senses have been honed and sharpened for over a decade.',
};
const POLICY = {
  head: 'Now, I’m learning about content policy and online safety.',
  emph: 'content policy and online safety',
  body: 'I’ve learned programming at NUS and have been plugged into tech news, especially global tech policy, for years. I’m looking to apply my editorial and communications skills towards custodianship of the internet.',
};
// A paragraph fades in once its headline is 60% typed.
const fd = (t: { head: string; emph: string }) => `--fd: ${typeChars(t.head, t.emph).fd}ms;`;

const icon = (d: [string, string]) => (s: number) =>
  `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d[0]}"></path><path d="${d[1]}"></path></svg>`;
const arrowRight = icon(['M4 12h16', 'M13.5 5.5 20 12l-6.5 6.5']);
const arrowLeft = icon(['M20 12H4', 'M10.5 5.5 4 12l6.5 6.5']);
const arrowDown = icon(['M12 4v16', 'M5.5 13.5 12 20l6.5-6.5']);
---

<BaseLayout
  title="Miguel Escobar — Strategic Communications & Editorial"
  description={SITE_DESCRIPTION}
  personSchema
  home
  current="home"
>
  <section id="top" class="me-hero">
    <div class="me-drift">
      <Typed as="p" text={STATEMENT} class="t-h1 me-statement me-typeload" t0={350} />
      <div class="me-grow"></div>
      <div class="me-cuerow">
        <span class="me-cueglow" aria-hidden="true"></span>
        <a class="me-cue" href="#work" aria-label="Scroll to work" set:html={arrowDown(22)} />
      </div>
      <h1 class="me-rise me-name"><span>Miguel</span> <span>Escobar</span></h1>
    </div>
  </section>

  <div class="me-chapters">
    <section id="work" class="me-work">
      <div class="heavy me-headrule me-workrule" aria-hidden="true"></div>
      <div class="me-workhead">
        <div class="me-rv">
          <Typed text={WORK_HEAD} emph="honest helpful human storytelling" class="t-h1 me-hl" />
        </div>
        <div class="me-railnav">
          <button class="me-railbtn" type="button" aria-label="Previous work" data-rail-prev disabled set:html={arrowLeft(18)} />
          <button class="me-railbtn" type="button" aria-label="More work" data-rail-next set:html={arrowRight(18)} />
        </div>
      </div>
      <div class="me-rv me-gal me-rail" data-rail>
        {
          rail.map((c) => (
            <a
              class="me-card"
              href={c.href}
              target={ext(c.href) ? '_blank' : undefined}
              rel={ext(c.href) ? 'noopener' : undefined}
            >
              <Frame
                image={c.image}
                alt={c.alt}
                ratio="1 / 1.4"
                sizes="(max-width: 899px) 220px, (max-width: 1199px) 30vw, 310px"
                widths={[220, 310, 440, 620]}
              />
              <div class="me-cardtext">
                <p class="t-label me-fade">{c.label}</p>
                <p class="me-fade me-card-desc" set:html={keepCompounds(c.title)} />
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section id="about" class="me-about">
      <div class="me-exit me-aboutgrid">
        <div class="me-abouttext">
          <div class="heavy me-headrule" aria-hidden="true"></div>
          <div class="me-textbox">
            <div class="me-rv">
              <Typed text={ABOUT.head} emph={ABOUT.emph} class="t-h2 me-hl" />
            </div>
            <div class="me-par-m me-gaptext">
              <div class="me-rv">
                <p class="t-bodyl me-fade me-chbody" style={fd(ABOUT)} set:html={keepCompounds(ABOUT.body)} />
              </div>
            </div>
          </div>
        </div>
        <div class="me-par-m me-plateholder">
          <div class="me-rv me-plate">
            <div class="me-map-d" set:html={mapDesktop} />
            <div class="me-map-m" set:html={mapMobile} />
          </div>
        </div>
      </div>
    </section>

    <div class="me-pair">
      <section id="editorial" class="me-editorial">
        <div class="me-exit-m me-edcol">
          <div class="heavy me-headrule" aria-hidden="true"></div>
          <div class="me-textbox">
            <div class="me-rv">
              <Typed text={EDITORIAL.head} emph={EDITORIAL.emph} class="t-h2 me-hl" />
            </div>
            <div class="me-par-m me-gaptext">
              <div class="me-rv">
                <p class="t-bodyl me-fade me-chbody" style={fd(EDITORIAL)}>{EDITORIAL.body}</p>
              </div>
            </div>
          </div>
          <div class="me-par-m me-edimg">
            <Frame
              image={magazines}
              alt="A pile of magazines, Esquire Philippines on top and Smile beneath it."
              ratio="5 / 3"
              cutout
              sizes="(max-width: 899px) 92vw, 50vw"
              widths={[480, 720, 960, 1240]}
            />
          </div>
          <div class="me-edspace" aria-hidden="true"></div>
          <div class="me-rv me-edlink">
            <div class="me-fade" style={fd(EDITORIAL)}>
              <a class="me-link" href="/work/#editorial"
                ><span class="me-link-label">More Editorial Work</span><span class="me-ring"
                  ><span class="me-arrow" set:html={arrowRight(17)} /></span
                ></a
              >
            </div>
          </div>
        </div>
      </section>

      <section id="branded" class="me-branded">
        <div class="me-reel me-onvideo" data-reel>
          <div class="me-reelvid">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              poster="/media/highlights-reel-4x5-poster.jpg"
              aria-hidden="true"
              tabindex="-1"
            >
              <source src="/media/highlights-reel-vertical.mp4" type="video/mp4" media="(max-width: 899px)" />
              <source src="/media/highlights-reel-4x5.mp4" type="video/mp4" />
            </video>
            <script is:inline>
              // Runs as the video is parsed, before playback can start: the phone's
              // poster, and no autoplay at all with reduced motion.
              (function () {
                var v = document.currentScript.previousElementSibling;
                if (matchMedia('(max-width: 899px)').matches) v.poster = '/media/highlights-reel-vertical-poster.jpg';
                if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
                  v.removeAttribute('autoplay');
                  v.preload = 'metadata';
                }
              })();
            </script>
          </div>
          <div class="me-rv me-reeltext">
            <div class="me-reelshade" aria-hidden="true"></div>
            <div class="me-reelinner">
              <div class="me-headrule me-reelrule" aria-hidden="true"></div>
              <Typed text={BRANDED.head} emph={BRANDED.emph} class="t-h2 me-hl" />
              <p class="t-bodyl me-fade me-reelbody" style={fd(BRANDED)}>{BRANDED.body}</p>
              <div class="me-fade me-reellink" style={fd(BRANDED)}>
                <a class="me-link" href="/work/#advertising"
                  ><span class="me-link-label">More Advertising Work</span><span class="me-ring"
                    ><span class="me-arrow" set:html={arrowRight(17)} /></span
                  ></a
                >
              </div>
            </div>
          </div>
          <button type="button" class="me-reelbtn" data-reel-btn aria-label="Pause the reel">
            <svg class="me-ico-pause" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
              ><rect x="4" y="3" width="2.25" height="10" fill="currentColor"></rect><rect x="9.75" y="3" width="2.25" height="10" fill="currentColor"></rect></svg
            >
            <svg class="me-ico-play" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"></path></svg
            >
          </button>
        </div>
      </section>
    </div>

    <section id="policy" class="me-pol">
      <div class="me-pol-stage">
        <div class="me-pol-glow" aria-hidden="true"></div>
        <div class="me-pol-content">
          <Typed text={POLICY.head} emph={POLICY.emph} class="t-h1 me-pol-hl me-pol-focus" />
          <div class="me-pol-focus me-pol-focus-2 me-pol-box">
            <p>{POLICY.body}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.documentElement.classList.add('js-ready');

  // ── Reveals: each part comes into play once, when its top is this far up the
  // screen (the boards' animation-range starts: 16%, the map 6%, the rail 30%,
  // Policy 82%). Anything already scrolled past counts as in.
  const reveal = (selector: string, percent: number) => {
    const els = document.querySelectorAll(selector);
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting || en.boundingClientRect.top < 0) {
            en.target.classList.add('is-in');
            io.unobserve(en.target);
          }
        }
      },
      { rootMargin: `0px 0px -${percent}% 0px` }
    );
    els.forEach((el) => io.observe(el));
  };
  reveal('.me-rv:not(.me-plate):not(.me-gal)', 16);
  reveal('.me-plate', 6);
  reveal('.me-gal', 30);
  reveal('.me-pol', 82);

  // ── The nav's name: in once the Work chapter's rule reaches the nav's foot,
  // out again above it.
  const navhome = document.querySelector<HTMLElement>('.me-navhome');
  const rule = document.querySelector<HTMLElement>('.me-workrule');
  const nav = document.querySelector<HTMLElement>('.me-nav');
  if (navhome && rule && nav) {
    let queued = false;
    const update = () => {
      queued = false;
      navhome.classList.toggle('is-in', rule.getBoundingClientRect().top <= nav.offsetHeight);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }

  // ── The rail: the rings beside the headline page it, a screen at a time ──
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  if (rail && prev && next) {
    const gap = () => parseFloat(getComputedStyle(rail).columnGap) || 0;
    const page = (dir: number) => rail.scrollBy({ left: dir * (rail.clientWidth + gap()), behavior: 'smooth' });
    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    const sync = () => {
      prev.disabled = rail.scrollLeft < 8;
      next.disabled = rail.scrollLeft > rail.scrollWidth - rail.clientWidth - 8;
    };
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }

  // ── The reel: autoplays muted and loops (the HTML asks for it, the iOS way:
  // autoplay muted loop playsinline). It pauses off screen and resumes on it,
  // never plays with reduced motion, and the button pauses and plays it. If the
  // browser refuses to start it on its own (iOS in Low Power Mode does, even
  // muted), the first tap anywhere on the page starts it.
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const video = reel?.querySelector('video');
  const btn = reel?.querySelector<HTMLButtonElement>('[data-reel-btn]');
  if (reel && video && btn) {
    video.muted = true;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let userPaused = reduce;
    let onScreen = true;

    // The button shows what the video is actually doing.
    const sync = () => {
      const paused = video.paused;
      reel.classList.toggle('is-paused', paused);
      btn.setAttribute('aria-label', paused ? 'Play the reel' : 'Pause the reel');
    };
    video.addEventListener('play', sync);
    video.addEventListener('playing', sync);
    video.addEventListener('pause', sync);

    const play = () => {
      if (userPaused || !onScreen) return;
      const q = video.play();
      if (q && q.catch) q.catch(() => sync());
    };

    if (reduce) video.pause();
    sync();

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            onScreen = en.isIntersecting;
            if (onScreen) play();
            else if (!video.paused) video.pause();
          }
        },
        { threshold: 0.1 }
      ).observe(video);
    } else {
      play();
    }

    // A tap is a user gesture, which lets a blocked video start. (Not a tap on
    // the button: its own click handler decides, and would undo this.)
    const kick = (e: Event) => {
      if (e.target instanceof Node && btn.contains(e.target)) return;
      if (video.paused) play();
    };
    document.addEventListener('touchend', kick, { passive: true });
    document.addEventListener('click', kick);
    video.addEventListener(
      'playing',
      () => {
        document.removeEventListener('touchend', kick);
        document.removeEventListener('click', kick);
      },
      { once: true }
    );

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (video.paused) {
        userPaused = false;
        onScreen = true;
        play();
      } else {
        userPaused = true;
        video.pause();
      }
    });
  }
</script>
