---
// Home (boards SkHome / SkHomeMobile): one continuous scroll. The masthead (the
// nav's rule, the name, the dateline) and the deck; five cards and the line on
// the work under them; the editorial and brand panels, with the magazines thrown across their
// seam and the highlights reel; the last statement, held while it fills in; the
// footer. Layout and motion are in src/styles/home.css; behaviour in
// src/scripts/site.ts, MagStack.astro and the reel script below.
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from '../components/Frame.astro';
import Cta from '../components/Cta.astro';
import MagStack from '../components/MagStack.astro';
import { SITE_DESCRIPTION } from '../consts';
import { rise, words } from '../utils/text';
import '../styles/home.css';

import trust from '../assets/images/home-advertising.jpg';
import ageChecks from '../assets/images/home-age-checks.jpg';
import eddie from '../assets/images/home-editorial.jpg';
import whitewash from '../assets/images/home-whitewash.jpg';
import pulpit from '../assets/images/home-pulpit.jpg';

// Statements: *emphasis*, | a line break from 900px up,   binds two words
// (src/utils/text.ts).
const DECK = 'Editorial instincts and | creative acuity for | work that illuminates';
const LEDE =
  'I’ve worked as a journalist, an editor, and a creative strategist | for publications and brands, bringing their stories to light | with *a clear and humanistic voice*.';
const EDITORIAL = {
  head: 'My *editorial background* | informs everything I do.',
  body: 'In Manila, I was an editor at the local edition of Esquire magazine, covering culture, politics, and current affairs. This formative chapter of my career is a core memory — it gave me a journalistic perspective that I’ve since applied in everything I do.',
};
const BRAND = {
  head: 'But I have much more | experience telling | stories *for brands*.',
  body: 'Of my thirteen years of experience, eleven have been in roles handling advertorials and brand campaigns. My strategic communication senses have been honed and sharpened for over a decade.',
};
const NOW = words(
  'My journalistic worldview, in these | strange times, has led me to obsess | over *technology* and its effects on our | society and institutions. For years, I’ve | been plugged into tech news and | media, reading, listening to, and | engaging with ideas from the frontiers | of that world. Now I’m learning to | apply my editorial skills towards work | in *tech policy* and *trust and safety*.'
);

// The cards, each in the colour of its half of the work. `kp` is kept on one
// line (except where five cards share 900–1199px).
const cards = [
  {
    half: 'is-brand',
    href: 'https://www.marketing-interactive.com/trust-bank-million-dollars-campaign',
    image: trust,
    alt: 'A woman laughing, a Trust cashback Visa card held over one eye, as banknotes and confetti rain down.',
    label: 'Fintech Campaign',
    title: 'Trust Bank Singapore: Cashback Card',
  },
  {
    half: 'is-brand',
    href: 'https://www.youtube.com/watch?v=HXkZmhEBnBQ',
    image: ageChecks,
    alt: 'A shopkeeper raising her hand to a boy holding beer beneath an “Under 18” sign, from the Age Assurance Measures campaign',
    label: 'Public Service',
    title: 'Age Verification in App Stores',
  },
  {
    half: 'is-editorial',
    href: 'https://www.youtube.com/watch?v=yY4LLYrMHt8',
    image: eddie,
    alt: 'A dramatic, low-key editorial portrait of an older man against a black background.',
    label: 'Cover Story',
    title: 'Eddie Garcia for',
    kp: 'Esquire Philippines',
  },
  {
    half: 'is-editorial',
    href: 'https://www.esquiremag.ph/politics/opinion/fighting-for-history-on-the-wikipedia-battlefield-a00207-20170817-lfrm2',
    image: whitewash,
    alt: 'Ferdinand Marcos collaged over a redacted Wikipedia “Martial law” article, for “How to Whitewash a Dictator”',
    label: 'Investigative Feature',
    title: 'The Wikipedians at War Over Truth',
  },
  {
    half: 'is-editorial',
    href: 'https://www.esquiremag.ph/long-reads/notes-and-essays/the-rise-of-pastor-culture-and-why-it-must-end-a1513-20170629-lfrm',
    image: pulpit,
    alt: 'Halftone hands reaching toward pixelated images inside retro computer windows, for “A Pulpit for Pastors of Porn.”',
    label: 'Investigative Feature',
    title: 'Exposing Intimate Image Abuse Groups',
  },
];

// The dateline's month as built (Singapore time); the site script keeps it current.
const sgNow = new Date(Date.now() + 8 * 3600 * 1000);
const issue = {
  text: sgNow.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }),
  iso: sgNow.toISOString().slice(0, 7),
};
---

<BaseLayout
  title="Miguel Escobar — Strategic Communications & Editorial"
  description={SITE_DESCRIPTION}
  personSchema
  home
>
  <section class="hx wrap" aria-label="Introduction">
    <h1 class="hx-name">
      <span class="hx-l hx-l1"><span>Miguel</span></span>
      <span class="hx-l hx-l2"><span>Escobar</span></span>
    </h1>
    <p class="t-label hx-date" data-rv style="--d: 3;">
      <span>Singapore</span>
      <time datetime={issue.iso} data-issue>{issue.text}</time>
    </p>
    <div class="hx-deck" data-rv style="--d: 4;">
      <p class="hx-deck-text" data-rise style="--rd: 480ms;" set:html={rise(DECK)} />
    </div>
  </section>

  <section id="work" class="s2 wrap" aria-label="Selected work">
    <ul class="s2-cards" data-rv-row>
      {
        cards.map((c, i) => (
          <li class:list={['s2-item', c.half]} data-rv style={`--d: ${i};`}>
            <a class="hcard" href={c.href} target="_blank" rel="noopener">
              <Frame
                image={c.image}
                alt={c.alt}
                ratio="3 / 4"
                sizes="(max-width: 899px) 264px, 18vw"
                widths={[264, 400, 528, 800]}
              />
              <span class="hcard-text">
                <span class="t-small hcard-label">{c.label}</span>
                <span class="t-copy hcard-title">
                  {c.title}
                  {c.kp && <span class="kp">{c.kp}</span>}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="t-state s2-lede" data-rise set:html={rise(LEDE)} />
  </section>

  <section id="about" class="s3 wrap" aria-label="Background">
    <div class="s3-grid">
      <div class="panel bt br s3-p1 is-editorial" data-frame>
        <h2 class="t-state s3-head" data-rise set:html={rise(EDITORIAL.head)} />
        <div class="s3-copy">
          <p class="t-copy" data-rv style="--d: 2;">{EDITORIAL.body}</p>
          <p class="s3-more" data-rv style="--d: 3;">
            <Cta href="/work/#editorial" label="More Editorial Work" />
          </p>
        </div>
      </div>

      <div class="panel bt bl s3-p2 is-brand" data-frame>
        <MagStack />
        <div class="s3-side">
          <h2 class="t-state s3-head s3-head2" data-rise set:html={rise(BRAND.head)} />
          <p class="s3-more" data-rv style="--d: 3;">
            <Cta href="/work/#advertising" label="More Brand Work" />
          </p>
        </div>
        <div class="s3-reel" data-reel>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/highlights-reel-4x5-poster.jpg"
            aria-hidden="true"
            tabindex="-1"
          >
            <source src="/media/highlights-reel-vertical.mp4" type="video/mp4" media="(max-width: 899px)" />
            <source src="/media/highlights-reel-4x5.mp4" type="video/mp4" />
          </video>
          <script is:inline>
            // Runs as the video is parsed, before playback can start: the phone's
            // poster, and no autoplay at all with reduced motion.
            (function () {
              var v = document.currentScript.previousElementSibling;
              if (matchMedia('(max-width: 899px)').matches) v.poster = '/media/highlights-reel-vertical-poster.jpg';
              if (matchMedia('(prefers-reduced-motion: reduce)').matches) v.removeAttribute('autoplay');
            })();
          </script>
          <span class="s3-shade" aria-hidden="true"></span>
          <p class="t-copy s3-reelbody">{BRAND.body}</p>
          <button type="button" class="s3-reelbtn" data-reel-btn aria-label="Pause the reel">
            <svg class="ico-pause" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"
              ><rect x="3.5" y="2.5" width="3" height="11" fill="currentColor"></rect><rect x="9.5" y="2.5" width="3" height="11" fill="currentColor"></rect></svg
            >
            <svg class="ico-play" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M4.5 2.6v10.8L13 8z" fill="currentColor"></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="now" class="s4 wrap" aria-label="What’s next" data-hold>
    <div class="s4-stage" data-hold-stage>
      <div class="panel bt s4-panel" data-frame>
        <div class="s4-text words" data-words style={`--n: ${NOW.n};`}>
          <p class="t-state" set:html={NOW.html} />
        </div>
      </div>
    </div>
    <div class="s4-run" aria-hidden="true"></div>
  </section>
</BaseLayout>

<script>
  // ── The reel: autoplays muted and loops (the HTML asks for it, the iOS way:
  // autoplay muted loop playsinline). It pauses off screen and resumes on it,
  // never plays with reduced motion, and the button pauses and plays it. If the
  // browser refuses to start it on its own (iOS in Low Power Mode does, even
  // muted), the first tap anywhere on the page starts it.
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const video = reel?.querySelector('video');
  const btn = reel?.querySelector<HTMLButtonElement>('[data-reel-btn]');
  if (reel && video && btn) {
    video.muted = true;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let userPaused = reduce;
    let onScreen = false;

    // The button shows what the video is actually doing.
    const sync = () => {
      const paused = video.paused;
      reel.classList.toggle('is-paused', paused);
      btn.setAttribute('aria-label', paused ? 'Play the reel' : 'Pause the reel');
    };
    video.addEventListener('play', sync);
    video.addEventListener('playing', sync);
    video.addEventListener('pause', sync);

    const play = () => {
      if (userPaused || !onScreen) return;
      const q = video.play();
      if (q && q.catch) q.catch(() => sync());
    };

    if (reduce) video.pause();
    sync();

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            onScreen = en.isIntersecting;
            if (onScreen) play();
            else if (!video.paused) video.pause();
          }
        },
        { threshold: 0.1 }
      ).observe(video);
    } else {
      onScreen = true;
      play();
    }

    // A tap is a user gesture, which lets a blocked video start. (Not a tap on
    // the button: its own click handler decides, and would undo this.)
    const kick = (e: Event) => {
      if (e.target instanceof Node && btn.contains(e.target)) return;
      if (video.paused) play();
    };
    document.addEventListener('touchend', kick, { passive: true });
    document.addEventListener('click', kick);
    video.addEventListener(
      'playing',
      () => {
        document.removeEventListener('touchend', kick);
        document.removeEventListener('click', kick);
      },
      { once: true }
    );

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (video.paused) {
        userPaused = false;
        onScreen = true;
        play();
      } else {
        userPaused = true;
        video.pause();
      }
    });
  }
</script>
