---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkImage from '../components/WorkImage.astro';
import { SITE_DESCRIPTION } from '../consts';

// All six cards use on-brand PLACEHOLDER art (Miguel is redoing the artwork).
// Swap one in by dropping a real photo in src/assets/images and pointing the
// card's `image` at it — see the README "Swapping in your real images" section.
import ageChecks from '../assets/images/ph_home_age-checks.png';
import osc from '../assets/images/ph_home_osc.png';
import whitewash from '../assets/images/ph_home_whitewash.png';
import pastors from '../assets/images/ph_home_pulpit.png';
import eddie from '../assets/images/ph_home_more-editorial.png';
import alconFilm from '../assets/images/ph_home_more-advertising.png';

// Order and copy follow the design hand-off (6 cards). The first two are recent
// Singapore projects with placeholder art and placeholder links (#) until real
// stills/URLs are added; Whitewash & Pulpit keep their published Esquire links.
const cards = [
  {
    title: 'Age Checks Matter',
    href: '#',
    blurb:
      'A film and campaign for the IMDA, launching Age Assurance Measures — age checks on app stores — in Singapore.',
    image: ageChecks,
    alt: 'Placeholder art for “Age Checks Matter,” an IMDA Age Assurance Measures film and campaign.',
  },
  {
    title: 'Launching The Online Safety Commission',
    href: '#',
    blurb:
      'Web copy, service articles, and explainer videos about online harms for the launch of Singapore’s Online Safety Commission.',
    image: osc,
    alt: 'Placeholder art for the launch of Singapore’s Online Safety Commission.',
  },
  {
    title: 'How to Whitewash a Dictator',
    href: 'https://www.esquiremag.ph/politics/opinion/fighting-for-history-on-the-wikipedia-battlefield-a00207-20170817-lfrm2',
    blurb:
      'An investigative feature on an invisible war for Philippine history, waged by Wikipedia editors on hotly contested pages.',
    image: whitewash,
    alt: 'Placeholder art for the feature “How to Whitewash a Dictator.”',
  },
  {
    title: 'A Pulpit for Pastors of Porn',
    href: 'https://www.esquiremag.ph/long-reads/notes-and-essays/the-rise-of-pastor-culture-and-why-it-must-end-a1513-20170629-lfrm',
    blurb:
      'An exposé that dug deep into a social media subculture of sexual predators in the Philippines, sparking a nationwide reckoning.',
    image: pastors,
    alt: 'Placeholder art for the exposé “A Pulpit for Pastors of Porn.”',
  },
  {
    title: 'More Editorial Work →',
    href: '/editorial-work/',
    blurb:
      'A selection of articles published with my byline, including for Esquire Philippines, Tatler Asia, and Smile Magazine.',
    image: eddie,
    alt: 'Placeholder art for the “More Editorial Work” card.',
  },
  {
    title: 'More Advertising Work →',
    href: '/advertising-work/',
    blurb:
      'A selection of ads and campaigns I’ve worked on, including for the NBA, Trust Bank, and Alcon.',
    image: alconFilm,
    alt: 'Placeholder art for the “More Advertising Work” card.',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title="Miguel Escobar — Strategic Communications & Editorial" description={SITE_DESCRIPTION} personSchema>
  <section class="hero wrap">
    <h1 class="hero-name">Miguel<br />Escobar</h1>
    <div class="hero-rule"></div>
    <div class="hero-grid">
      <p class="positioning">
        Strategic Communications. Content Governance. Editorial Operations. APAC&nbsp;Markets.
      </p>
      <div class="bio">
        <p>
          A Singapore-based professional with a journalist’s instincts. Intellectually
          curious, plugged into culture and tech, terminally online and AI-pilled.
        </p>
        <p>
          At Esquire Philippines, I covered culture, politics, and current affairs, writing, producing,
          and editing everything from daily articles to investigative features. Over 12+ years I’ve moved
          across editorial, content operations, and strategic communications, working with brands like the
          NBA, Trust Bank, Samsung, and Toyota across the Philippines and Singapore. I’ve managed
          high-volume content projects, enforced editorial standards across several publications, and built
          communications strategies and content governance frameworks for brands.
        </p>
        <p class="last">In all I do, I find purpose in telling stories that are honest, helpful, and human.</p>
      </div>
    </div>
  </section>

  <div class="wrap rule"></div>

  <section class="work wrap">
    <div class="work-head" data-reveal>
      <h2>Some work</h2>
    </div>
    <div class="grid">
      {
        cards.map((card) => (
          <article class="card" data-reveal>
            <WorkImage
              image={card.image}
              alt={card.alt}
              ratio="3 / 4"
              sizes="(max-width: 640px) 92vw, (max-width: 1080px) 45vw, 320px"
              widths={[320, 480, 760]}
            />
            <h3>
              <a
                href={card.href}
                target={isExternal(card.href) ? '_blank' : undefined}
                rel={isExternal(card.href) ? 'noopener' : undefined}
              >
                {card.title}
              </a>
            </h3>
            <p>{card.blurb}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(40px, 8vh, 96px) 0 clamp(48px, 7vw, 96px);
  }
  .hero-name {
    margin: 0 0 clamp(28px, 4vw, 48px);
    font-family: var(--font-serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(54px, 11vw, 164px);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .hero-rule {
    height: 1px;
    background: var(--ink);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .positioning {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.28;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .bio {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.65;
  }
  .bio p {
    margin: 0 0 1.4em;
  }
  .bio p.last {
    margin: 0;
    font-weight: 400;
  }

  .work {
    padding: clamp(40px, 6vw, 72px) 0 clamp(64px, 9vw, 128px);
  }
  .work-head {
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .work-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(42px, 5.8vw, 80px);
    letter-spacing: -0.008em;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: clamp(40px, 4vw, 56px) 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card h3 {
    margin: 0;
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-80);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .hero-name {
      font-size: clamp(46px, 15vw, 124px);
      line-height: 1.06;
    }
  }
</style>
