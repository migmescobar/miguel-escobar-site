---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';

// The three "doors" carry their flood colours as data attributes; the script
// paints them onto the flood surface on hover.
const doors = [
  { label: 'About', href: '/about/', bg: '#0047BB', ink: '#EAE7E1' },
  { label: 'Work', href: '/work/', bg: '#C95227', ink: '#141414' },
  { label: 'Thoughts', href: '/thoughts/', bg: '#6B4C5E', ink: '#EAE7E1' },
];
---

<BaseLayout
  title="Miguel Escobar — Strategic Communications & Editorial"
  description={SITE_DESCRIPTION}
  personSchema
  bare
>
  <div class="flood" data-flood>
    <div class="inner">
      <h1 class="hero" data-hero><span>MIGUEL</span><span>ESCOBAR</span></h1>

      <div class="spacer"></div>

      <nav class="doors" aria-label="Primary">
        {
          doors.map((d) => (
            <a class="door" href={d.href} data-door data-bg={d.bg} data-ink={d.ink}>
              <span class="door-label">{d.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .flood {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 3vh, 44px) var(--pad) 0;
    background: var(--paper);
    color: var(--ink);
    transition:
      background 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .inner {
    container-type: inline-size;
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Both words sit in one nowrap row so the fit script scales them together —
     they must never wrap or be set at different sizes. font-size here is only a
     starting value; the script overwrites it in cqw. */
  .hero {
    margin: 0;
    display: flex;
    gap: 0.2em;
    align-items: baseline;
    font-weight: 400;
    font-size: 11.5cqw;
    line-height: 0.86;
    letter-spacing: -0.03em;
    white-space: nowrap;
    font-kerning: normal;
  }

  .spacer {
    flex: 1;
    min-height: clamp(40px, 8vh, 120px);
  }

  .doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--hairline);
  }
  .door {
    display: flex;
    padding: 26px 24px 30px 0;
    text-decoration: none;
    opacity: 1;
    transition: opacity 0.45s ease;
  }
  .door:last-child {
    padding-right: 0;
  }
  .door-label {
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.06;
    letter-spacing: -0.004em;
  }

  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .door {
      padding: 18px 0 20px;
    }
    .door + .door {
      border-top: 1px solid var(--hairline);
    }
  }
</style>

<script>
  const flood = document.querySelector<HTMLElement>('[data-flood]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const doors = [...document.querySelectorAll<HTMLAnchorElement>('[data-door]')];

  // ── Hero size fitting ──────────────────────────────────────────────────────
  // Measure the rendered text with a Range and rewrite font-size as cqw scaled
  // by available/measured. Keeps MIGUEL and ESCOBAR on one line at one size at
  // every width — that equality is the requirement, so never let it wrap.
  function fitHero() {
    if (!hero) return;
    const box = hero.parentElement;
    if (!box) return;
    const cs = getComputedStyle(box);
    const available =
      box.clientWidth - parseFloat(cs.paddingLeft || '0') - parseFloat(cs.paddingRight || '0');
    if (available <= 0) return;

    const range = document.createRange();
    range.selectNodeContents(hero);
    const measured = range.getBoundingClientRect().width;
    if (!measured) return;

    const current = parseFloat(getComputedStyle(hero).fontSize);
    // 0.997 is a hair of safety against sub-pixel overflow.
    const targetPx = (current * available) / measured * 0.997;
    hero.style.fontSize = `${(targetPx / box.clientWidth) * 100}cqw`;
  }

  fitHero();
  window.addEventListener('resize', fitHero);
  document.fonts?.ready.then(fitHero);

  // ── Colour flood (desktop only) ────────────────────────────────────────────
  // Everything on the page inherits currentColor, so recolouring the surface
  // inverts the whole page — nothing else needs restyling.
  const desktop = window.matchMedia('(min-width: 761px)');

  function reset() {
    if (!flood) return;
    flood.style.background = '';
    flood.style.color = '';
    doors.forEach((d) => (d.style.opacity = '1'));
  }

  doors.forEach((door) => {
    door.addEventListener('mouseenter', () => {
      if (!desktop.matches || !flood) return;
      flood.style.background = door.dataset.bg || '';
      flood.style.color = door.dataset.ink || '';
      doors.forEach((d) => (d.style.opacity = d === door ? '1' : '0.3'));
    });
  });

  flood?.addEventListener('mouseleave', reset);
  desktop.addEventListener('change', (e) => {
    if (!e.matches) reset();
  });
</script>
