---
// 404 (boards SkNotFound / SkNotFoundMobile).
import BaseLayout from '../layouts/BaseLayout.astro';
import { rise } from '../utils/text';

const links = [
  { href: '/', label: 'Home' },
  { href: '/work/#editorial', label: 'Editorial Work' },
  { href: '/work/#advertising', label: 'Brand Work' },
  { href: '/thoughts/', label: 'Some Thoughts' },
];
---

<BaseLayout
  title="Page not found — Miguel Escobar"
  description="That page doesn’t exist. Head back to the homepage, or browse the work and writing."
  noindex
>
  <div class="pg wrap">
    <div class="pg-col">
      <h1 class="t-title pg-title" data-rise set:html={rise('Page not found')} />
      <div class="rule nf-rule"></div>
      <p class="t-label nf-label" data-rv>Error 404</p>
      <div class="nf-grid">
        <p
          class="t-state nf-text"
          data-rise
          style="--rd: 200ms;"
          set:html={rise('The page you’re looking for doesn’t exist, or may have moved.')}
        />
        <nav class="nf-links" aria-label="Helpful links" data-rv style="--d: 1;">
          {
            links.map(({ href, label }) => (
              <a class="nf-link t-copy" href={href}>
                <span>{label}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
                  <path d="M4 12h16" />
                  <path d="M13.5 5.5 20 12l-6.5 6.5" />
                </svg>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .nf-rule {
    margin-top: calc(48px - var(--s-title) * (0.94 - 0.714) / 2);
  }
  .nf-label {
    margin-top: calc(16px - var(--trim));
  }
  .nf-text {
    margin-top: calc(32px - var(--trim));
    max-width: 14em;
  }
  .nf-links {
    margin-top: 40px;
    border-top: var(--heavy) solid var(--ink);
  }
  .nf-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(19px - var(--trim)) 0;
    text-decoration: none;
  }
  .nf-link + .nf-link {
    border-top: var(--hair) solid var(--ink);
  }
  .nf-link svg {
    transition: transform 0.5s var(--ease);
  }
  .nf-link:hover svg {
    transform: translateX(4px);
  }
  /* The words in columns 1–9 of the eighteen, the links in 12–18. */
  @media (min-width: 900px) {
    .nf-rule {
      margin-top: calc(80px - var(--s-title) * (0.94 - 0.714) / 2);
    }
    .nf-grid {
      display: grid;
      grid-template-columns: repeat(18, minmax(0, 1fr));
      column-gap: var(--g);
      align-items: start;
    }
    .nf-text {
      grid-column: 1 / span 9;
    }
    .nf-links {
      grid-column: 12 / span 7;
      margin-top: 32px;
    }
  }
</style>
