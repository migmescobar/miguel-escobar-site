---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  personSchema?: boolean;
  articleHeadline?: string;
  /** Home is a single-viewport "door" page: no header, no footer, no scroll. */
  bare?: boolean;
}

const { bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      {!bare && <Header />}
      <main id="main" class:list={{ bare }}>
        <slot />
      </main>
      {!bare && <Contact />}
    </div>

    <style>
      .page {
        /* svh is the viewport with the mobile browser's address bar SHOWING —
           the smallest it gets. Plain vh resolves to the *large* viewport (bar
           hidden), which on a phone is taller than what's actually visible, so
           a "one viewport" page ends up needing a small scroll to reach its
           bottom edge. svh guarantees it fits without scrolling; dvh would also
           fit but re-flows as the bar slides, which would re-run the Home hero
           fit mid-gesture. vh first as the fallback for older browsers. */
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
        padding: 0 var(--pad);
      }
      /* Home supplies its own padding and owns the full viewport. */
      main.bare {
        display: flex;
        flex-direction: column;
        padding: 0;
      }
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 10px 16px;
        z-index: 100;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 8px;
        top: 8px;
      }
    </style>

    <script>
      // Reveal-on-scroll observer. Only meaningful when the inline <head> script
      // opted in (motion allowed); otherwise the CSS keeps everything visible.
      if (document.documentElement.classList.contains('reveal-ready')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            }
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
