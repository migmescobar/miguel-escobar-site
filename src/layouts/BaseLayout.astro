---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  personSchema?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Contact />
    </div>

    <style>
      .page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
        padding: 0 var(--pad);
      }
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 10px 16px;
        z-index: 100;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 8px;
        top: 8px;
      }
    </style>

    <script>
      // Reveal-on-scroll observer. Only meaningful when the inline <head> script
      // opted in (motion allowed); otherwise the CSS keeps everything visible.
      if (document.documentElement.classList.contains('reveal-ready')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            }
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
